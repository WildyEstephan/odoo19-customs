<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Vista del Wizard para crear contacto desde RNC -->
    <record id="view_partner_from_rnc_wizard_form" model="ir.ui.view">
        <field name="name">l10n_do.partner.from.rnc.wizard.form</field>
        <field name="model">l10n_do.partner.from.rnc.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear Contacto desde RNC">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del Contacto"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Datos del RNC">
                            <field name="vat"/>
                            <field name="vat_type"/>
                            <field name="company_type" widget="radio"/>
                            <field name="l10n_do_dgii_tax_payer_type"/>
                        </group>
                        <group string="Información DGII">
                            <field name="l10n_do_dgii_name"/>
                            <field name="l10n_do_dgii_status"/>
                            <field name="l10n_do_dgii_activity"/>
                            <field name="l10n_do_dgii_category"/>
                        </group>
                    </group>

                    <group>
                        <group string="Información Adicional">
                            <field name="l10n_do_dgii_commercial_name"/>
                            <field name="l10n_do_dgii_payment_regime"/>
                            <field name="l10n_do_dgii_local_admin"/>
                        </group>
                        <group string="Datos de Contacto (Opcional)">
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="street"/>
                            <field name="city"/>
                        </group>
                    </group>

                    <field name="move_id" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_create_partner"
                            string="Crear"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_create_and_edit_partner"
                            string="Crear y Editar"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción del Wizard -->
    <record id="action_partner_from_rnc_wizard" model="ir.actions.act_window">
        <field name="name">Crear Contacto desde RNC</field>
        <field name="res_model">l10n_do.partner.from.rnc.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
