<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Hereda la vista de formulario del partner para agregar campos DGII -->
    <record id="view_partner_form_dgii_info" model="ir.ui.view">
        <field name="name">res.partner.form.dgii.info</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- Agregar botón para actualizar datos de la DGII -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_update_dgii_data"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-refresh"
                        invisible="country_id != %(base.do)d or not vat"
                        string="Actualizar DGII">
                </button>
            </xpath>

            <!-- Agregar página de información DGII en el notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Información DGII" name="dgii_info"
                      invisible="country_id != %(base.do)d">
                    <group>
                        <group string="Datos del Contribuyente">
                            <field name="l10n_do_dgii_name" force_save="1"/>
                            <field name="l10n_do_dgii_commercial_name" force_save="1"/>
                            <field name="l10n_do_dgii_status" force_save="1"/>
                            <field name="l10n_do_dgii_category" force_save="1"/>
                        </group>
                        <group string="Información Fiscal">
                            <field name="l10n_do_dgii_payment_regime" force_save="1"/>
                            <field name="l10n_do_dgii_activity" force_save="1"/>
                            <field name="l10n_do_dgii_local_admin" force_save="1"/>
                            <field name="l10n_do_dgii_last_update" force_save="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Agregar campos DGII a la vista de lista del partner -->
    <record id="view_partner_tree_dgii" model="ir.ui.view">
        <field name="name">res.partner.tree.dgii</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="l10n_do_dgii_status" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Agregar filtros de búsqueda para campos DGII -->
    <record id="view_partner_search_dgii" model="ir.ui.view">
        <field name="name">res.partner.search.dgii</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter string="RNC Activo"
                        name="dgii_active"
                        domain="[('l10n_do_dgii_status', 'ilike', 'activo')]"/>
                <filter string="RNC Inactivo"
                        name="dgii_inactive"
                        domain="[('l10n_do_dgii_status', 'ilike', 'inactivo')]"/>
            </xpath>
        </field>
    </record>

</odoo>
