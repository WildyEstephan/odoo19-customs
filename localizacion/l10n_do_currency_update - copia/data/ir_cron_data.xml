<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <!--
        Cron para actualizar tasas de cambio desde API del Banco Central
        Configurado para ejecutarse diariamente a las 6:00 AM (hora local RD = UTC-4)
        Modificado: 2025-12-08 - Arturo Diaz Lora
        Razón: Establecer hora fija de ejecución a las 6:00 AM
    -->
    <record id="ir_cron_currency_update" model="ir.cron">
        <field name="name">[CURRENCY] Update l10n_do banks currency</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 10:00:00')"/>
        <field name="state">code</field>
        <field name="model_id" ref="model_res_company"/>
        <field name="code">model.l10n_do_run_update_currency()</field>
        <field name="active">True</field>
    </record>

</odoo>