<odoo noupdate="1">
    <record id="ecf_cron_invoices_delivered_pending" model="ir.cron">
        <field name="name">ECF: Send Invoice Pending to NETVUX</field>
        <field name="model_id" ref="l10n_do_ecf_connector.model_ecf_document"/>
        <field name="state">code</field>
        <field name="code">model.cron_ecf_invoices_pending_send_netvux()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ecf_cron_invoices_to_dent" model="ir.cron">
        <field name="name">ECF: To Sent to NETVUX</field>
        <field name="model_id" ref="l10n_do_ecf_connector.model_ecf_document"/>
        <field name="state">code</field>
        <field name="code">model.cron_ecf_invoices_to_dent_netvux()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
