<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ecf_configuration_view" model="ir.ui.view">
        <field name="name">ecf.configuration.view</field>
        <field name="model">ecf.settings</field>
        <field name="arch" type="xml">
            <form string="Electronic Vouchers Configuration">
                <sheet>
                    <group string="General">
                        <group>
                            <field name="name"/>
                            <field name="ce_version" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="environment"/>
                        </group>
                    </group>
                    <group string="User info">
                        <group>
                            <field name="user"/>
                            <field name="key"/>
                        </group>
                        <div>
                            <button name="action_verify" type="object" string="PROBAR CONEXIÓN" class="oe_highlight"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ecf_configuration_view_tree" model="ir.ui.view">
        <field name="name">ecf.configuration.view.list</field>
        <field name="model">ecf.settings</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="environment"/>
            </list>
        </field>
    </record>
    <record id="ecf_configuration_view_kanban" model="ir.ui.view">
        <field name="name">ecf.configuration.view.kanban</field>
        <field name="model">ecf.settings</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="environment"/>
                <field name="ce_version"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title">
                                    <field name="name"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="environment"/>
                                    <field name="ce_version"/>
                                </div>
                                <div class="oe_clear"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ecf_configuration_action" model="ir.actions.act_window">
        <field name="name">Electronic Vouchers Settings</field>
        <field name="res_model">ecf.settings</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
          <p class="oe_view_nocontent_create">
            Haga clic para agregar un registro.
          </p><p>
            Una registro de Configuración de Comprobantes Electrónicos permite añadir toda la información necesaria para el envio de documentos a DGII.
          </p>
        </field>
    </record>
    <menuitem id="ecf_documents_root" name="DGII" groups="account.group_account_manager" web_icon="l10n_do_ecf_connector,static/img/dgii_logo2.png">
        <menuitem id="ecf_documents_main" name="Electronic Vouchers">
            <menuitem id="ecf_documents_menu"
                      action="action_ecf_document_action"
                      sequence="1"/>

            <menuitem id="ecf_settings_menu"
                      action="ecf_configuration_action" sequence="2"/>
        </menuitem>
    </menuitem>
</odoo>
