<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_form_partner_inherit" model="ir.ui.view">
        <field name="name">view.form.partner.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='street2']" position="after">
                <field name="res_municipality_id" placeholder="Municipality..."
                       context="{'state_id': state_id, 'default_state_id': state_id}" class="oe_edit_only"/>
            </xpath>
        </field>
    </record>
</odoo>