<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_move_reversal_inherited" model="ir.ui.view">
        <field name="name">view.account.move.reversal.inherited</field>
        <field name="model">account.move.reversal</field>
        <field name="inherit_id" ref="account.view_account_move_reversal"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='modify_moves']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//form" position="inside">
                <group string="Tipo de reembolso" col="4">
                    <field name="refund_type" options="{'horizontal': true}" widget="radio" string="Tipo de reembolso"/>
                </group>
                <group string="Importe de la Nota de Crédito" col="4">
                    <field name="percentage" invisible="refund_type != 'percentage'" required="refund_type == 'percentage'" string="Porcentaje"/>
                    <field name="amount" invisible="refund_type != 'fixed_amount'" required="refund_type == 'fixed_amount'" string="Monto fijo"/>
                    <field name="account_id" groups="account.group_account_user" options="{'no_open': True, 'no_create': True}" invisible="refund_type == 'full_refund'" required="refund_type != 'full_refund'" string="Cuenta contable"/>
                </group>
                <group string="Opciones de líneas" col="4" invisible="1">
                    <field name="copy_lines" string="Copiar líneas de productos"/>
                    <field name="custom_description" 
                           string="Descripción personalizada"
                           invisible="copy_lines == True"
                           required="copy_lines == False"
                           placeholder="Ingrese una descripción para la nota de crédito"/>
                </group>
                <group string="Comprobante fiscal" col="4">
                    <field name="l10n_latam_country_code" invisible="1"/>
                    <field name="is_ecf_invoice" invisible="1"/>
                <field name="l10n_latam_use_documents" invisible="1"/>
                <field name="l10n_latam_manual_document_number" invisible="1"/>
                <field name="l10n_latam_available_document_type_ids" invisible="1"/>
                <field name="show_vendor_fields" invisible="1"/>
                <field name="l10n_latam_document_type_id"
                           invisible="l10n_latam_country_code != 'DO'"
                           required="l10n_latam_country_code == 'DO'"
                           options="{'no_open': True, 'no_create': True}"
                           string="Tipo de Comprobante"/>
                <field name="l10n_latam_document_number"
                       invisible="not show_vendor_fields or not l10n_latam_manual_document_number"
                           required="show_vendor_fields and l10n_latam_manual_document_number"
                           string="Número de Comprobante"
                           placeholder="B04000000001 o E34000000000001"
                           help="Formato NCF: B + 2 dígitos (03-04) + 8 dígitos = 11 caracteres (Físicos)&#10;Formato e-NCF: E + 2 dígitos (33-34) + 11 dígitos = 14 caracteres (Electrónicos)"/>
                <field name="l10n_do_origin_ncf"
                       string="NCF modificado"
                       invisible="l10n_latam_country_code != 'DO'"
                       readonly="1"
                       placeholder="NCF de la factura original que se modifica"/>
                <field name="l10n_do_ecf_modification_code"
                           invisible="l10n_latam_country_code != 'DO' or not is_ecf_invoice"
                           required="l10n_latam_country_code == 'DO' and is_ecf_invoice"
                           string="Código de Modificación e-CF"/>
                <field name="l10n_do_ncf_expiration_date"
                       string="Válida hasta"
                       invisible="l10n_latam_country_code != 'DO'"
                       required="show_vendor_fields"
                       readonly="0"
                       help="Fecha de vencimiento del NCF"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
