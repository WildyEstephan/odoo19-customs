<!-- Razón: Agregar regla multi-company para account.move.tax -->
<odoo>
    <record id="account_fiscal_sequence_comp_rule" model="ir.rule">
        <field name="name">Account Fiscal Sequence Company Rule</field>
        <field name="model_id" ref="model_account_fiscal_sequence"/>
        <field eval="True" name="global"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="account_move_tax_comp_rule" model="ir.rule">
        <field name="name">Account Move Tax Company Rule</field>
        <field name="model_id" ref="model_account_move_tax"/>
        <field eval="True" name="global"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
