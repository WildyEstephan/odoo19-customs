<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="web_address_layout_inherited" inherit_id="web.address_layout">
        <!-- do not show company address on document header  -->
        <xpath expr="//div[@t-if='address']/div" position="attributes">
            <attribute name="t-if">doc_model != "account.move" or (doc_model == "account.move" and o.company_id.l10n_do_country_code != "DO")</attribute>
        </xpath>
    </template>

    <!-- do not show partner address on document header when l10n do invoice -->

    <template id="external_layout_standard_inherited" inherit_id="web.external_layout_standard">
        <!-- Ajuste para la dirección de la empresa -->
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="t-if">doc_model != 'account.move' or (doc_model == 'account.move' and o.company_id.l10n_do_country_code != 'DO')</attribute>
        </xpath>

        <!-- Información completa de la empresa en la parte superior derecha para facturas dominicanas -->
        <!-- MODIFICADO: Arturo Diaz Lora - 2026-02-22 -->
        <!-- Razón: Agregada condición l10n_do_hide_company_header para ocultar info de compañía -->
        <xpath expr="//div[@name='company_address']" position="after">
            <div t-if="doc_model == 'account.move' and o.company_id.l10n_do_country_code == 'DO' and not o.company_id.l10n_do_hide_company_header" style="text-align: right; line-height: 1.4; font-size: 14px;">
                <div style="font-weight: bold; margin-bottom: 3px;">
                    <span t-field="o.company_id.partner_id.name"/>
                </div>
                <div><strong>RNC:</strong> <span t-field="o.company_id.vat"/></div>
                <div><strong>Dirección:</strong> <span t-field="o.company_id.partner_id.street"/></div>
                <div><strong>Ciudad:</strong> <span t-field="o.company_id.partner_id.city"/></div>
                <div t-if="o.company_id.partner_id.phone"><strong>Teléfono:</strong> <span t-field="o.company_id.partner_id.phone"/></div>
                <div t-if="o.company_id.partner_id.email"><strong>Email:</strong> <span t-field="o.company_id.partner_id.email"/></div>
            </div>
        </xpath>
    </template>


    <template id="external_layout_boxed_inherited" inherit_id="web.external_layout_boxed">
        <!-- Ajuste para la dirección de la empresa -->
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="t-if">doc_model != 'account.move' or (doc_model == 'account.move' and o.company_id.l10n_do_country_code != 'DO')</attribute>
        </xpath>

        <!-- Información completa de la empresa en la parte superior derecha para facturas dominicanas -->
        <!-- MODIFICADO: Arturo Diaz Lora - 2026-02-22 -->
        <!-- Razón: Agregada condición l10n_do_hide_company_header para ocultar info de compañía -->
        <xpath expr="//div[@name='company_address']" position="after">
            <div t-if="doc_model == 'account.move' and o.company_id.l10n_do_country_code == 'DO' and not o.company_id.l10n_do_hide_company_header" style="text-align: right; line-height: 1.4; font-size: 14px;">
                <div style="font-weight: bold; margin-bottom: 3px;">
                    <span t-field="o.company_id.partner_id.name"/>
                </div>
                <div><strong>RNC:</strong> <span t-field="o.company_id.vat"/></div>
                <div><strong>Dirección:</strong> <span t-field="o.company_id.partner_id.street"/></div>
                <div><strong>Ciudad:</strong> <span t-field="o.company_id.partner_id.city"/></div>
                <div t-if="o.company_id.partner_id.phone"><strong>Teléfono:</strong> <span t-field="o.company_id.partner_id.phone"/></div>
                <div t-if="o.company_id.partner_id.email"><strong>Email:</strong> <span t-field="o.company_id.partner_id.email"/></div>
            </div>
        </xpath>
    </template>

    <!-- MODIFICADO: Arturo Diaz Lora - 2026-02-22 -->
    <!-- Razón: Agregar herencia para layout striped (faltaba, solo estaban standard y boxed) -->
    <template id="external_layout_striped_inherited" inherit_id="web.external_layout_striped">
        <!-- Ocultar dirección de la empresa original para facturas dominicanas -->
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="t-if">doc_model != 'account.move' or (doc_model == 'account.move' and o.company_id.l10n_do_country_code != 'DO')</attribute>
        </xpath>

        <!-- Información completa de la empresa en la parte superior derecha para facturas dominicanas -->
        <!-- Solo se muestra si l10n_do_hide_company_header es False -->
        <xpath expr="//div[@name='company_address'][1]" position="after">
            <div t-if="doc_model == 'account.move' and o.company_id.l10n_do_country_code == 'DO' and not o.company_id.l10n_do_hide_company_header" style="text-align: right; line-height: 1.4; font-size: 14px;">
                <div style="font-weight: bold; margin-bottom: 3px;">
                    <span t-field="o.company_id.partner_id.name"/>
                </div>
                <div><strong>RNC:</strong> <span t-field="o.company_id.vat"/></div>
                <div><strong>Dirección:</strong> <span t-field="o.company_id.partner_id.street"/></div>
                <div><strong>Ciudad:</strong> <span t-field="o.company_id.partner_id.city"/></div>
                <div t-if="o.company_id.partner_id.phone"><strong>Teléfono:</strong> <span t-field="o.company_id.partner_id.phone"/></div>
                <div t-if="o.company_id.partner_id.email"><strong>Email:</strong> <span t-field="o.company_id.partner_id.email"/></div>
            </div>
        </xpath>
    </template>

</odoo>
