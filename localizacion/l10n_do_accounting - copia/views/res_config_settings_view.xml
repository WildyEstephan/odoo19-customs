<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form11" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherited11</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='contacts_settings']" position="inside">
                <block title="Dominican Localization" name="contacts_setting_container11">
                    <setting help="Automatically Get Data From DGII" title="When populating your address book, Odoo provides a list of matching companies. When selecting one item, the company data and logo are auto-filled." id="partner_autocomplete">
                        <field name="module_l10n_do_partner_autocomplete"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
    <!-- MODIFICADO: Arturo Diaz Lora - 2026-02-22 -->
    <!-- Razón: Agregar checkbox para ocultar info de compañía en encabezado de facturas -->
    <record id="res_config_settings_view_form_l10n_do_hide_header" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.l10n_do.hide.header</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='document_layout_setting']" position="after">
                <setting id="l10n_do_hide_company_header_setting"
                         string="Ocultar Info Compañía (RD)"
                         help="Oculta la información de la compañía (RNC, dirección, teléfono, email) en el encabezado derecho de las facturas dominicanas."
                         company_dependent="1">
                    <field name="l10n_do_hide_company_header"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
