<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <form>
                <field name="l10n_latam_available_document_type_ids" invisible="1"/>
                <field name="l10n_latam_use_documents" invisible="1"/>
                <field name="l10n_latam_manual_document_number" invisible="1"/>
            </form>

            <!-- on latam_documents we use document_number to set name -->
            <field name="name" position="attributes">
                <attribute name="readonly">
                    state != 'draft' or l10n_latam_use_documents == True
                </attribute>
            </field>

            <xpath expr="//form/sheet/div[hasclass('oe_title')]" position="inside">
                <div class="alert alert-warning" role="alert" invisible="not warning_message">
                    <field name="warning_message" style="white-space: pre-wrap;"/>
                </div>
            </xpath>

            <field name="restrict_mode_hash_table" position="after">
                <field name="is_ecf_invoice" invisible="1"/>
                <field name="l10n_latam_country_code" invisible="1"/>
                <field name="l10n_do_company_in_contingency" invisible="1"/>
            </field>
            <!-- En Odoo 19 el campo tax_lock_date_message no está en la vista base -->
            <xpath expr="//sheet" position="inside">
                <div class="alert alert-warning"
                     role="alert" style="margin-bottom:0px;"
                     invisible="not l10n_do_company_in_contingency or state != 'draft'">
                    Notice. This company is in a transient state of contingency for Electronic Invoice issuing. NCF
                    issuing has been enabled.
                </div>
            </xpath>
            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="invisible">
                    id == False and state != 'draft' and l10n_latam_country_code != 'DO' and state in ['draft',
                    'cancel'] and l10n_latam_country_code == 'DO'
                </attribute>
            </xpath>
            <xpath expr="//h1/span/.." position="inside">
                <span invisible="move_type != 'out_refund' or state != 'cancel'">
                    Cancelled Credit Note
                </span>
                <span invisible="move_type != 'in_refund' or state != 'cancel'">
                    Cancelled Refund
                </span>
            </xpath>
            <xpath expr="//h1/span/.." position="after">
                <h4 invisible="state != 'cancel'">
                    Cancellation Reason:
                    <br/>
                    <field name="l10n_do_cancellation_type" readonly="1"/>
                </h4>
            </xpath>
<!--            <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/field[@name='partner_id']" position="after">-->
            <!-- MODIFICADO: Arturo Diaz Lora - 2026-02-16 - Agregar verificación de l10n_latam_use_documents -->
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="l10n_latam_document_type_id"
                       string="Tipo de Documento"
                       invisible="l10n_latam_country_code != 'DO' or move_type == 'entry' or not l10n_latam_use_documents"
                       required="l10n_latam_country_code == 'DO' and move_type != 'entry' and l10n_latam_use_documents"
                       readonly="posted_before"
                       domain="[('id', 'in', l10n_latam_available_document_type_ids)]"
                       options="{'no_open': True, 'no_create': True}"/>
                <field name="l10n_latam_document_number"
                       string="Número de Documento"
                       required="l10n_latam_manual_document_number and l10n_latam_use_documents and l10n_latam_country_code == 'DO' and move_type != 'entry'"
                       invisible="l10n_latam_country_code != 'DO' or move_type == 'entry' or not l10n_latam_use_documents"
                       readonly="state != 'draft'"
                       placeholder="B01000000001 o E31000000000001"
                       help="Formato NCF: B + 2 dígitos (01-17) + 8 dígitos = 11 caracteres (Físicos)&#10;Formato e-NCF: E + 2 dígitos (31-47) + 11 dígitos = 14 caracteres (Electrónicos)&#10;&#10;Notas de Crédito: B04 + 8 dígitos o E34 + 11 dígitos&#10;Notas de Débito: B03 + 8 dígitos o E33 + 11 dígitos"/>
                <field name="l10n_do_income_type"
                       string="Tipo de Ingreso"
                       invisible="l10n_latam_country_code != 'DO' or move_type != 'out_invoice' or not l10n_latam_use_documents"
                       required="l10n_latam_use_documents and move_type == 'out_invoice' and l10n_latam_country_code == 'DO'"
                       readonly="state != 'draft'"/>
                <field name="l10n_do_expense_type"
                       string="Tipo de Costos y Gastos"
                       invisible="l10n_latam_country_code != 'DO' or move_type not in ('in_invoice', 'in_refund') or not l10n_latam_use_documents"
                       required="l10n_latam_use_documents and move_type in ('in_invoice', 'in_refund') and l10n_latam_country_code == 'DO'"
                       readonly="state != 'draft'"/>
                <field name="debit_origin_id" invisible="1"/>
                <field name="is_debit_note" invisible="1"/>
                <field name="l10n_do_origin_move_type_filter" invisible="1"/>
                <!-- MODIFICADO: Arturo Diaz Lora - 2026-02-22
                     Razón: Dropdown para seleccionar factura original en NC/ND manuales
                     Ubicado arriba de NCF modificado. Permite clic para navegar a la factura.
                     Al seleccionar trae NCF y líneas de factura automáticamente -->
                <field name="l10n_do_origin_move_id"
                       string="Factura Original"
                       invisible="l10n_latam_country_code != 'DO' or not (move_type in ('out_refund', 'in_refund') or is_debit_note) or not l10n_latam_use_documents"
                       readonly="state != 'draft'"
                       domain="[
                           ('partner_id', '=', partner_id),
                           ('state', '=', 'posted'),
                           ('move_type', '=', l10n_do_origin_move_type_filter),
                           ('l10n_latam_document_number', '!=', False),
                           ('l10n_latam_use_documents', '=', True),
                           ('payment_state', '!=', 'reversed'),
                           ('debit_origin_id', '=', False),
                           ('reversed_entry_id', '=', False)
                       ]"
                       options="{'no_create': True}"/>
                <!-- MODIFICADO: Arturo Diaz Lora - 2026-02-22 - NCF modificado:
                     readonly cuando hay Factura Original seleccionada (se auto-llena)
                     o cuando la factura está publicada. Editable manualmente si no hay Factura Original -->
                <field name="l10n_do_origin_ncf"
                       string="NCF modificado"
                       invisible="l10n_latam_country_code != 'DO' or not (move_type in ('out_refund', 'in_refund') or is_debit_note) or not l10n_latam_use_documents"
                       required="l10n_latam_country_code == 'DO' and l10n_latam_use_documents and (move_type in ('out_refund', 'in_refund') or is_debit_note)"
                       readonly="state != 'draft' or l10n_do_origin_move_id"
                       force_save="1"/>
                <field name="l10n_do_ecf_modification_code"
                       string="Código Modificación e-CF"
                       invisible="l10n_latam_country_code != 'DO' or not (move_type in ('out_refund', 'in_refund') or is_debit_note) or not is_ecf_invoice or not company_id.l10n_do_ecf_issuer or not l10n_latam_use_documents"
                       required="l10n_latam_country_code == 'DO' and l10n_latam_use_documents and (move_type in ('out_refund', 'in_refund') or is_debit_note) and is_ecf_invoice and company_id.l10n_do_ecf_issuer"/>
                <!-- MODIFICADO: Arturo Diaz Lora - 2026-02-23
                     Razón: Mover Referencia de factura debajo de Código Modificación e-CF
                     para todos los tipos de documento (facturas y notas crédito/débito) -->
                <field name="ref" string="Referencia de factura"
                       invisible="l10n_latam_country_code != 'DO' or move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund') or not l10n_latam_use_documents"
                       readonly="state != 'draft'"/>
            </xpath>
            
            <!-- Ocultar el campo ref original en su posición inicial -->
            <xpath expr="//group[@id='header_left_group']//field[@name='ref']" position="attributes">
                <attribute name="invisible">l10n_latam_country_code == 'DO' and move_type in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')</attribute>
            </xpath>
            
            <!-- Ocultar el campo invoice_vendor_bill_id (Autocompletar) para República Dominicana -->
            <xpath expr="//field[@name='invoice_vendor_bill_id']" position="attributes">
                <attribute name="invisible">l10n_latam_country_code == 'DO'</attribute>
            </xpath>
            
            <!-- Ocultar la etiqueta del campo invoice_vendor_bill_id -->
            <xpath expr="//label[@for='invoice_vendor_bill_id']" position="attributes">
                <attribute name="invisible">l10n_latam_country_code == 'DO'</attribute>
            </xpath>
            

            
            <!-- Ocultar específicamente la primera instancia del campo ref (Autocompletar) -->
            <xpath expr="//group[@id='header_left_group']//field[@name='ref'][1]" position="attributes" optional="hide">
                <attribute name="invisible">l10n_latam_country_code == 'DO' and move_type in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')</attribute>
            </xpath>
            
            <!-- Ocultar la etiqueta de la primera instancia del campo ref -->
            <xpath expr="//group[@id='header_left_group']//label[@for='ref'][1]" position="attributes" optional="hide">
                <attribute name="invisible">l10n_latam_country_code == 'DO' and move_type in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')</attribute>
            </xpath>
            
            <!-- Mover Válida hasta debajo de Fecha de la factura para proveedores -->
            <!-- MODIFICADO: Arturo Diaz Lora - 2026-02-16 - Ocultar si diario no usa documentos fiscales -->
            <xpath expr="//group[@id='header_right_group']//field[@name='invoice_date'][2]" position="after" optional="hide">
                <field name="l10n_do_ncf_expiration_date"
                       string="Válida hasta"
                       invisible="l10n_latam_country_code != 'DO' or not l10n_latam_use_documents"
                       required="l10n_latam_country_code == 'DO' and l10n_latam_use_documents and move_type in ('in_invoice', 'in_refund')"
                       readonly="state != 'draft'"
                       help="Fecha de vencimiento del NCF"/>
            </xpath>

            <!-- only computed when l10n_do ecf invoice -->
<!--            <xpath expr="//page[@id='invoice_tab']/field[@name='invoice_line_ids']/list/field[@name='tax_ids']"-->
<!--                   position="after">-->
<!--                <field name="l10n_do_itbis_amount" invisible="1" force_save="1"/>-->
<!--            </xpath>-->
<!--            <xpath expr="//page[@id='aml_tab']/field[@name='line_ids']/list/field[@name='tax_line_id']"-->
<!--                   position="after">-->
<!--                <field name="l10n_do_itbis_amount" invisible="1" force_save="1"/>-->
<!--            </xpath>-->
            <xpath expr="//field[@name='tax_totals']" position="replace">
                <field name="total_discount" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                <field name="tax_totals" string="Subtotal" widget="account-tax-totals-field" nolabel="1" colspan="2"/>
            </xpath>
            
            <!-- MODIFICADO: Arturo Diaz Lora - 2026-02-16 - Mostrar botón estándar si diario no usa documentos fiscales -->
            <!-- Hide standard Credit Note button for Dominican Republic ONLY if using fiscal documents -->
            <xpath expr="//button[@name='action_reverse'][@data-hotkey='shift+n']" position="attributes">
                <attribute name="invisible">move_type not in ('out_invoice', 'in_invoice') or state != 'posted' or (l10n_latam_country_code == 'DO' and l10n_latam_use_documents)</attribute>
            </xpath>
            
            <!-- Hide smart button for debit notes in Dominican Republic -->
            <xpath expr="//div[hasclass('oe_button_box')]//button[@name='action_view_debit_notes'][hasclass('oe_stat_button')]" position="attributes" optional="hide">
                <attribute name="invisible">l10n_latam_country_code == 'DO'</attribute>
            </xpath>

            <!-- MODIFICADO: Arturo Diaz Lora - 2026-02-16 - Mostrar botón estándar si diario no usa documentos fiscales -->
            <!-- Ocultar botón genérico de Nota de Débito (enterprise) para RD SOLO si usa documentos fiscales -->
            <xpath expr="//button[@name='action_debit_note'][@data-hotkey='shift+d']" position="attributes" optional="hide">
                <attribute name="invisible">move_type not in ('out_invoice', 'in_invoice') or state != 'posted' or (l10n_latam_country_code == 'DO' and l10n_latam_use_documents)</attribute>
            </xpath>

            <!-- MODIFICADO: Arturo Diaz Lora - 2026-02-16 - Agregar verificación de l10n_latam_use_documents -->
            <!-- Add Debit Note buttons to header - ONLY visible for DR with fiscal documents -->
            <xpath expr="//button[@name='action_reverse']" position="after">
                <!-- Create Debit Note - Dominican fiscal flow -->
                <button name="action_debit_note" string="Notas de débito"
                        type="object" groups="account.group_account_invoice"
                        invisible="move_type not in ('out_invoice', 'in_invoice') or state != 'posted' or l10n_latam_country_code != 'DO' or not l10n_latam_use_documents"
                        data-hotkey="shift+d"/>
                <!-- View Debit Notes -->
                <button name="action_view_debit_notes" type="object" groups="account.group_account_invoice"
                        invisible="debit_note_count == 0 or l10n_latam_country_code != 'DO'">
                    <span>Ver Notas de Débito (<field name="debit_note_count"/>)</span>
                </button>
                <!-- Create Credit Note - Dominican fiscal flow -->
                <button name="action_credit_note" string="Notas de crédito"
                        type="object" groups="account.group_account_invoice"
                        invisible="move_type not in ('out_invoice', 'in_invoice') or state != 'posted' or l10n_latam_country_code != 'DO' or not l10n_latam_use_documents"
                        data-hotkey="shift+c"/>
                <!-- View Credit Notes -->
                <button name="action_view_credit_notes" type="object" groups="account.group_account_invoice"
                        invisible="credit_note_count == 0 or l10n_latam_country_code != 'DO'">
                    <span>Ver Notas de Crédito (<field name="credit_note_count"/>)</span>
                </button>
            </xpath>
            
            <!-- Add Debit Note count as invisible field for the button condition -->
            <xpath expr="//field[@name='restrict_mode_hash_table']" position="after">
                <field name="debit_note_count" invisible="1"/>
                <field name="debit_origin_id" invisible="1"/>
                <field name="credit_note_count" invisible="1"/>
                <field name="reversed_entry_id" invisible="1"/>
            </xpath>
            
            <!-- Show original invoice for debit notes -->
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="debit_origin_id" 
                       string="Original Invoice" 
                       readonly="1"
                       invisible="not debit_origin_id"/>
                <!-- MODIFICADO: Arturo Diaz Lora - 2026-02-22
                     Razón: Solo mostrar reversed_entry_id cuando NO se muestra l10n_do_origin_move_id
                     para evitar duplicación del campo "Factura Original" en NC creadas desde botón -->
                <field name="reversed_entry_id"
                       string="Factura Original"
                       readonly="1"
                       invisible="not reversed_entry_id or (l10n_latam_country_code == 'DO' and l10n_latam_use_documents)"/>
            </xpath>
        </field>
    </record>
    <record id="invoice_tree_inherited_out_invoice" model="ir.ui.view">
        <field name="name">invoice.list.inherited.out.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_latam_document_number" readonly="1"/>
            </xpath>
        </field>
    </record>
    <record id="invoice_tree_inherited_in_invoice" model="ir.ui.view">
        <field name="name">invoice.list.inherited.in.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_latam_document_number" readonly="1"/>
            </xpath>
        </field>
    </record>
    <record id="view_out_credit_note_tree_inherit" model="ir.ui.view">
        <field name="name">view.out.credit.note.list.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_credit_note_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_latam_document_number" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Actions for Credit and Debit Notes -->
    
    <!-- Out Debit Notes (Customer Debit Notes) -->
    <record id="action_move_out_debit_note" model="ir.actions.act_window">
        <field name="name">Notas de débito</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="domain">[("move_type","=","out_invoice"), ("debit_origin_id","!=",False)]</field>
        <field name="context">{
            'default_move_type': 'out_invoice',
            'move_type': 'out_invoice',
            'journal_type': 'sale',
            'internal_type': 'debit_note',
            'search_default_draft': 1,
            'search_default_posted': 1,
            }</field>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nota de débito
            </p>
            <p>
                La forma más sencilla de crear una nota de débito es hacerlo directamente desde la factura del cliente.
            </p>
        </field>
    </record>

    <menuitem action="action_move_out_debit_note"
              id="menu_action_move_out_debit_note"
              parent="account.menu_finance_receivables"
              sequence="4"
              name="Notas de débito"/>

    <!-- In Debit Notes (Vendor Debit Notes) -->
    <record id="action_move_in_debit_note" model="ir.actions.act_window">
        <field name="name">Notas de débito</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_in_invoice_tree"/>
        <field name="domain">[("move_type","=","in_invoice"), ("debit_origin_id","!=",False)]</field>
        <field name="context">{
            'default_move_type': 'in_invoice',
            'move_type': 'in_invoice',
            'journal_type': 'purchase',
            'internal_type': 'debit_note',
            'search_default_posted': 1,
            }</field>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registrar una nueva nota de débito de proveedor
            </p>
        </field>
    </record>

    <menuitem action="action_move_in_debit_note"
              id="menu_action_move_in_debit_note"
              parent="account.menu_finance_payables"
              groups="l10n_do_accounting.group_l10n_do_debit_note"
              sequence="12"
              name="Notas de débito"/>

    <!-- Exclude debit notes from actual vendor/customer invoices actions -->
    <record id="account.action_move_out_invoice_type" model="ir.actions.act_window">
        <field name="domain">[('move_type', '=', 'out_invoice'), ('debit_origin_id', '=', False), ('reversed_entry_id', '=', False)]</field>
    </record>
    <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
        <field name="domain">[('move_type', '=', 'in_invoice'), ('debit_origin_id', '=', False), ('reversed_entry_id', '=', False)]</field>
    </record>
    
    <!-- Also modify the main invoice actions used in menus -->
    <record id="account.action_move_out_invoice" model="ir.actions.act_window">
        <field name="domain">[('move_type', 'in', ['out_invoice', 'out_refund']), ('debit_origin_id', '=', False), ('reversed_entry_id', '=', False)]</field>
    </record>
    <record id="account.action_move_in_invoice" model="ir.actions.act_window">
        <field name="domain">[('move_type', 'in', ['in_invoice', 'in_refund']), ('debit_origin_id', '=', False), ('reversed_entry_id', '=', False)]</field>
    </record>

    <!-- MODIFICADO: Arturo Diaz Lora - 2026-02-23
         Razón: Ocultar campos duplicados de l10n_latam_invoice_document en el grupo derecho
         cuando el país es DO, ya que l10n_do_accounting los agrega en el grupo izquierdo
         con condiciones y etiquetas específicas para República Dominicana.
         Se hereda de l10n_latam_invoice_document.view_move_form para garantizar
         que se aplique después de que esos campos existan en la vista -->
    <record id="view_move_form_hide_latam_duplicates" model="ir.ui.view">
        <field name="name">account.move.form.hide.latam.duplicates.do</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_latam_invoice_document.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']/following-sibling::field[@name='l10n_latam_document_type_id']" position="attributes">
                <attribute name="invisible">l10n_latam_country_code == 'DO' or not l10n_latam_use_documents</attribute>
            </xpath>
            <xpath expr="//div[@name='journal_div']/following-sibling::field[@name='l10n_latam_document_number']" position="attributes">
                <attribute name="invisible">l10n_latam_country_code == 'DO' or ((not l10n_latam_use_documents or not l10n_latam_manual_document_number) and (not l10n_latam_use_documents or highest_name or state != 'draft'))</attribute>
            </xpath>
        </field>
    </record>

</odoo>