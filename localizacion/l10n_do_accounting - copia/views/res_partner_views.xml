<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_property_form_inherited" model="ir.ui.view">
        <field name="name">view.partner.property.form</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name'][1]" position="replace">
                <field name="name" id="company" class="text-break" default_focus="1" placeholder="Nombre, RNC o Cédula"
                       required="type =='contact' and is_company"
                       invisible="not is_company"/>
            </xpath>
            <!-- Ocultar el campo vat original de su posición -->
            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Agregar Tipo de contribuyente y RNC en el group después de website (para que labels aparezcan a la izquierda) -->
            <xpath expr="//field[@name='website']" position="after">
                <field name="is_fiscal_info_required" invisible="1"/>
                <field name="l10n_do_dgii_tax_payer_type" string="Tipo Contribuyente" readonly="parent_id != False" placeholder="Seleccione tipo..."/>
                <field name="vat" string="RNC/Cédula" placeholder="000-0000000-0" readonly="parent_id != False" required="is_fiscal_info_required"/>
            </xpath>
            <xpath expr="//field[@name='property_supplier_payment_term_id']" position="after">
                <field name="l10n_do_expense_type"/>
            </xpath>
        </field>
    </record>
</odoo>
