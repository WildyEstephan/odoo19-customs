<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ocultar botón "Reverse Entry" en notas de crédito y débito electrónicas -->
    <record id="view_move_form_hide_reverse_button" model="ir.ui.view">
        <field name="name">account.move.form.hide.reverse.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(account.action_view_account_move_reversal)d']" position="attributes">
                <attribute name="invisible">move_type != 'entry' or state != 'posted' or payment_state == 'reversed' or (l10n_latam_use_documents and l10n_latam_country_code == 'DO' and (move_type in ('in_refund', 'out_refund') or debit_origin_id))</attribute>
            </xpath>
        </field>
    </record>
</odoo>