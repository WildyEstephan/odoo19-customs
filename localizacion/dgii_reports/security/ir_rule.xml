<!-- Razón: Agregar reglas multi-company para modelos de líneas DGII -->
<odoo>

    <record id="dgii_reports_rule" model="ir.rule">
        <field name="name">DGII Reports Company Rule</field>
        <field name="model_id" ref="model_dgii_reports"/>
        <field eval="True" name="global"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]
