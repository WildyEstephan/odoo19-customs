<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Hereda la vista de formulario de factura para agregar búsqueda de RNC -->
    <record id="view_move_form_dgii_rnc_search" model="ir.ui.view">
        <field name="name">account.move.form.dgii.rnc.search</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Campos invisibles para datos temporales -->
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="l10n_do_rnc_data_ready" invisible="1"/>
                <field name="l10n_do_rnc_temp_commercial_name" invisible="1"/>
                <field name="l10n_do_rnc_temp_payment_regime" invisible="1"/>
                <field name="l10n_do_rnc_temp_category" invisible="1"/>
                <field name="l10n_do_rnc_temp_local_admin" invisible="1"/>
                <field name="l10n_do_rnc_temp_vat_type" invisible="1"/>
            </xpath>

            <!-- Agregar sección de búsqueda de RNC antes del campo partner_id -->
            <xpath expr="//field[@name='partner_id']" position="before">
                <div class="d-flex align-items-center gap-2 mb-2"
                     invisible="state != 'draft' or company_id.country_id != %(base.do)d">
                    <field name="l10n_do_rnc_search"
                           placeholder="Buscar por RNC/Cédula..."
                           class="o_field_highlight"
                           style="max-width: 200px;"/>
                    <button name="action_create_partner_quick"
                            type="object"
                            string="Crear"
                            class="btn-primary btn-sm"
                            icon="fa-plus"
                            invisible="not l10n_do_rnc_data_ready"
                            title="Crear contacto con datos de DGII"/>
                    <button name="action_create_partner_and_edit"
                            type="object"
                            string="Crear y editar"
                            class="btn-secondary btn-sm"
                            icon="fa-edit"
                            invisible="not l10n_do_rnc_data_ready"
                            title="Crear contacto y abrir formulario para editar"/>
                </div>
            </xpath>

            <!-- Mostrar información del RNC consultado -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <div class="alert alert-info py-2 mb-2"
                     role="alert"
                     invisible="not l10n_do_rnc_preview_name or partner_id">
                    <div class="d-flex align-items-center">
                        <span class="fa fa-info-circle me-2" title="Información DGII"/>
                        <div>
                            <strong>Datos DGII:</strong>
                            <field name="l10n_do_rnc_preview_name" readonly="1" nolabel="1" class="fw-bold"/>
                            <span invisible="not l10n_do_rnc_preview_status" class="ms-2">
                                | Estado: <field name="l10n_do_rnc_preview_status" readonly="1" nolabel="1"/>
                            </span>
                            <div invisible="not l10n_do_rnc_preview_activity" class="text-muted small">
                                Actividad: <field name="l10n_do_rnc_preview_activity" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
