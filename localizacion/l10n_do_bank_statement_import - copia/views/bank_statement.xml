<odoo>
    <record id="bank_statement_import_line_wizard" model="ir.ui.view">
        <field name="name">bank.statement.import.line.wizard</field>
        <field name="model">account.bank.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Bank Statements">
                <field name="bank_st" invisible="1"/>
                
                <!-- Campos principales del formulario -->
                <group>
                    <field name="journal_id" invisible="1"/>
                    <field name="name" placeholder="Ingrese el nombre del extracto"/>
                    <field name="data_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                
                <!-- Sección para el extracto manual -->
                <div class="alert alert-warning" role="alert" invisible="bank_st != 'manual'">
                    <h2> Importar Extracto Manual</h2>
                    <p>Este Diario está en forma <strong>manual</strong>, por lo que debe utilizar la siguiente plantilla:</p>
                    <ul id="statement_manual_template">
                        <li>Plantilla Extracto Manual (.CSV)
                            <a href="/l10n_do_bank_statement_import/static/csv/plantilla_extracto_manual.csv" class="ml4">
                                <i class="fa fa-download mr4"></i>Descargar Plantilla
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Sección para extractos desde el banco -->
                <div class="alert alert-info" role="alert" invisible="bank_st == 'manual'">
                    <h2>Utilizar extracto desde el Banco.</h2>
                    <p>Descargue un extracto bancario de su banco e impórtelo aquí sin tener que hacer modificaciones en el archivo. Formatos soportados:</p>
                    <ul>
                        <li>Banco Popular Dominicano BPD: <strong>txt</strong></li>
                        <li>Banco BHD: <strong>csv</strong></li>
                        <li>Banco Scotiabank: <strong>csv</strong></li>
                        <li>Banco Banreservas: <strong>csv</strong></li>
                    </ul>
                    <p>Tener en cuenta que antes de importar el Diario (Banco) este debe tener el
                        <strong>número de cuenta</strong> y cambiar el tipo
                        <strong>Formato de Conciliación del Banco</strong> y elegir el banco soportado.
                    </p>
                    <p>Ir al módulo
                        <strong>Contabilidad</strong> → Configuración (ajustes) → Diarios contables → Click en el Diario (Banco)
                    </p>
                </div>

                <!-- Secciones específicas para cada banco -->
                <div class="alert alert-warning" role="alert" invisible="bank_st != 'scotiabank'">
                    <h3>Favor asegúrese que el archivo esté en formato: <strong>.CSV</strong></h3>
                    <h3>Antes de importar su extracto, asegúrese de que el archivo contenga el siguiente encabezado:</h3>
                    <ul>
                        <li><strong>Fecha</strong> -> En formato: <strong>DD/MM/AAAA</strong></li>
                        <li><strong>Descripción</strong></li>
                        <li><strong>Documento</strong></li>
                        <li><strong>Monto</strong></li>
                    </ul>
                </div>

                <div class="alert alert-warning" role="alert" invisible="bank_st != 'reserva'">
                    <h3>Favor asegúrese que el archivo esté en formato: <strong>.CSV</strong></h3>
                    <h3>Antes de importar su extracto, asegúrese de que el archivo contenga el siguiente encabezado:</h3>
                    <ul>
                        <li><strong>Producto</strong></li>
                        <li><strong>Fecha</strong></li>
                        <li><strong>ID de Transacción</strong></li>
                        <li><strong>Débito</strong></li>
                        <li><strong>Crédito</strong></li>
                        <li><strong>Balance</strong></li>
                        <li><strong>Descripción</strong></li>
                        <li><strong>Referencia</strong></li>
                    </ul>
                </div>

                <!-- Otras secciones para diferentes bancos -->
                <div class="alert alert-warning" role="alert" invisible="bank_st != 'bhd'">
                    <h3>Favor asegúrese que el archivo esté en formato: <strong>.CSV</strong></h3>
                    <h3>Antes de importar su extracto, tener en cuenta lo siguiente:</h3>
                    <ul>
                        <li><strong>Fecha:</strong> Colocar corte del Movimiento</li>
                        <li><strong>Tipo De extracto</strong> -> Seleccionar: <strong>Descargar Movimientos</strong></li>
                        <li><strong>Encabezado</strong>: Sin Encabezado</li>
                        <li><strong>Cotejar solo</strong>: Excluir transacciones anuladas</li>
                    </ul>
                </div>

                <!-- Más condiciones para otros bancos -->
                <div class="alert alert-warning" role="alert" invisible="bank_st != 'popular'">
                    <h3>Favor asegúrese que el archivo esté en formato: <strong>.TXT</strong></h3>
                </div>

                <div class="alert alert-warning" role="alert" invisible="bank_st != 'santacruz'">
                    <h3>Favor asegúrese que el archivo esté en formato: <strong>.CSV</strong></h3>
                </div>

                <div class="alert alert-warning" role="alert" invisible="bank_st != 'lopezharo'">
                    <h3>Favor asegúrese que el archivo esté en formato: <strong>.CSV</strong></h3>
                </div>

                <div class="alert alert-warning" role="alert" invisible="bank_st != 'promerica'">
                    <h3>Favor asegúrese que el archivo esté en formato: <strong>.XLSX</strong></h3>
                </div>

                <div class="alert alert-warning" role="alert" invisible="bank_st != 'acap'">
                    <h3>Favor asegúrese que el archivo esté en formato: <strong>.CSV</strong></h3>
                </div>

                <div class="alert alert-warning" role="alert" invisible="bank_st != 'coopedac'">
                    <h3>Favor asegúrese que el archivo esté en formato: <strong>.CSV</strong></h3>
                </div>

                <footer>
                    <button name="import_dominican_statement" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_bank_statement_import_line_wizard" model="ir.actions.act_window">
        <field name="name">Importacion De Extractos Bancarios</field>
        <field name="res_model">account.bank.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
