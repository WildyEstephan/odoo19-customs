<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- l10n_do_accounting - Reporte de factura (Odoo 19)                  -->
    <!-- Apariencia replicada de la versión 17 (PDF INV/2026/00039):        -->
    <!--   1. RNC y Fecha del emisor (sin repetir la razón social)          -->
    <!--   2. Bloque de cliente: "RNC Cliente" / "Nombre o Razón social"    -->
    <!--   3. Título grande gris: "Factura ... INV/2026/xxxxx"             -->
    <!--   4. NCF y datos fiscales                                          -->
    <!--   5. Fila "Fecha límite" / "Fuente" / "Referencia"                 -->
    <!--   6. Tabla: DESCRIPCIÓN | CANTIDAD | PRECIO UNITARIO | IMPUESTOS  -->
    <!--             | IMPORTE, con encabezado en color corporativo         -->
    <!--   7. Totales: Subtotal / ITBIS / Total / Pagado el / Importe       -->
    <!--      adeudado                                                      -->
    <!-- ================================================================== -->

    <template id="l10n_do_report_invoice_document" inherit_id="account.report_invoice_document">

        <xpath expr="//t[@t-set='o']" position="after">
            <!-- When is a e-CF representation, additional info is displayed -->
            <t t-set="ecf_representation" t-value="o.company_id.l10n_do_ecf_issuer"/>
            <t t-set="is_l10n_do_invoice" t-value="o.l10n_latam_use_documents and o.company_id.country_id and o.company_id.l10n_do_country_code == 'DO'"/>
        </xpath>

        <!-- Ocultar el título estándar cuando es una factura de localización dominicana
             (se dibuja más abajo, después del bloque del cliente, como en v17) -->
        <xpath expr="//div[hasclass('page', 'mb-4')]//t[@t-set='layout_document_title']" position="attributes">
            <attribute name="t-if">not is_l10n_do_invoice</attribute>
        </xpath>

        <!-- ============================================================== -->
        <!-- ESTILO VISUAL TIPO v17 (solo facturas dominicanas)             -->
        <!-- ============================================================== -->
        <xpath expr="//div[@id='informations']" position="before">
            <t t-if="is_l10n_do_invoice">
                <t t-set="do_color" t-value="o.company_id.primary_color or '#0b2a3c'"/>
                <style>
                    .o_main_table thead th {
                        text-transform: uppercase;
                        font-weight: 700;
                        color: <t t-out="do_color"/>;
                        border-top: 2px solid <t t-out="do_color"/>;
                        border-bottom: 2px solid <t t-out="do_color"/>;
                    }
                    .o_main_table tbody td {
                        border-left: 1px solid #ececec;
                        border-right: 1px solid #ececec;
                    }
                    .o_main_table tbody tr:last-child td {
                        border-bottom: 2px solid <t t-out="do_color"/>;
                    }
                    #total table tr:last-child td {
                        border-bottom: 2px solid <t t-out="do_color"/>;
                        font-weight: 700;
                    }
                </style>
            </t>
        </xpath>

        <!-- ============================================================== -->
        <!-- ENCABEZADO: emisor, cliente, título y datos fiscales           -->
        <!-- ============================================================== -->
        <xpath expr="//div[@id='informations']" position="before">
            <div id="do_informations" t-if="is_l10n_do_invoice">

                <!-- Emisor: solo RNC y Fecha (el nombre ya aparece en el logo/encabezado) -->
                <div class="mb-3">
                    <div t-if="o.company_id.vat">
                        <strong>RNC: </strong>
                        <span t-field="o.company_id.vat"/>
                    </div>
                    <div t-if="o.invoice_date">
                        <strong>Fecha: </strong>
                        <span t-field="o.invoice_date" t-options='{"widget": "date"}'/>
                    </div>
                </div>

                <!-- Cliente -->
                <div class="mb-3" name="invoice_partner_address">
                    <t t-set="vat" t-value="o.partner_id.vat or ''"/>
                    <t t-set="vat_digits" t-value="''.join(c for c in vat if c.isdigit())"/>
                    <!-- RNC (9 dígitos) => 000-00000-0 ; Cédula (11 dígitos) => 000-0000000-0 -->
                    <t t-set="vat_fmt"
                       t-value="('%s-%s-%s' % (vat_digits[:3], vat_digits[3:8], vat_digits[8:])) if (vat.isdigit() and len(vat_digits) == 9) else (('%s-%s-%s' % (vat_digits[:3], vat_digits[3:10], vat_digits[10:])) if (vat.isdigit() and len(vat_digits) == 11) else vat)"/>
                    <div t-if="vat">
                        <strong>
                            <t t-if="len(vat_digits) == 9">RNC Cliente:</t>
                            <t t-elif="len(vat_digits) == 11">Cédula Cliente:</t>
                            <t t-else="">ID Cliente:</t>
                        </strong>
                        <span class="m-0" t-out="vat_fmt"/>
                    </div>
                    <div>
                        <strong>Nombre o Razón social:</strong>
                        <t t-if="o.partner_id.is_company or not o.partner_id.parent_id">
                            <span class="m-0" t-field="o.partner_id.name"/>
                            <t t-if="o.partner_id.phone">
                                <br/>
                                <strong>Tel.:</strong>
                                <span t-field="o.partner_id.phone"/>
                            </t>
                        </t>
                        <t t-else="">
                            <t t-set="commercial_partner_id" t-value="o.partner_id.commercial_partner_id"/>
                            <span class="m-0" t-field="commercial_partner_id.name"/>
                            <br/>
                            <strong>Contacto:</strong>
                            <span t-field="o.partner_id.name"/>
                            <t t-if="commercial_partner_id.phone">
                                <br/>
                                <strong>Tel.:</strong>
                                <span t-field="commercial_partner_id.phone"/>
                            </t>
                        </t>
                    </div>
                    <span t-if="o.partner_id.street" class="m-0" t-field="o.partner_id"
                          t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                </div>

                <!-- Título (estilo v17: grande y gris) -->
                <h2 class="mt-3 mb-2" style="color: #9a9fa5; font-weight: 700;">
                    <t t-if="o.state == 'draft'">Borrador </t>
                    <t t-if="o.state == 'cancel'">Anulada </t>
                    <span t-out="o.l10n_latam_document_type_id.report_name or 'Factura'"/>
                    <span t-if="o.name and o.name != '/'" t-field="o.name"/>
                </h2>

                <!-- Datos fiscales -->
                <div class="mb-2" t-if="o.l10n_latam_document_number">
                    <strong>
                        <t t-if="o.is_ecf_invoice">e-NCF:</t>
                        <t t-else="">NCF:</t>
                    </strong>
                    <span t-field="o.l10n_latam_document_number"/>

                    <!-- NCF modificado para notas de crédito -->
                    <t t-if="o.move_type in ('out_refund', 'in_refund') and (o.l10n_do_origin_ncf != False)">
                        <br/>
                        <strong>NCF modificado:</strong>
                        <span t-field="o.l10n_do_origin_ncf"/>
                        <t t-if="ecf_representation">
                            <br/>
                            <strong>Código Modificación:</strong>
                            <span t-field="o.l10n_do_ecf_modification_code"/>
                        </t>
                    </t>

                    <!-- NCF modificado para notas de débito de cliente -->
                    <t t-if="o.move_type == 'out_invoice' and o.debit_origin_id and o.debit_origin_id.l10n_latam_document_number">
                        <br/>
                        <strong>NCF modificado:</strong>
                        <span t-field="o.debit_origin_id.l10n_latam_document_number"/>
                        <t t-if="ecf_representation">
                            <br/>
                            <strong>Código Modificación:</strong>
                            <span t-field="o.l10n_do_ecf_modification_code"/>
                        </t>
                    </t>

                    <!-- NCF modificado para notas de débito de proveedor -->
                    <t t-if="o.move_type == 'in_invoice' and o.debit_origin_id and (o.l10n_do_origin_ncf != False)">
                        <br/>
                        <strong>NCF modificado:</strong>
                        <span t-field="o.l10n_do_origin_ncf"/>
                        <t t-if="ecf_representation">
                            <br/>
                            <strong>Código Modificación:</strong>
                            <span t-field="o.l10n_do_ecf_modification_code"/>
                        </t>
                    </t>

                    <!-- Vigencia: excluir E32 (consumo) y E34 (crédito) -->
                    <t t-if="o.state == 'posted' and o.l10n_do_ncf_expiration_date and o.l10n_latam_document_type_id.doc_code_prefix not in ['E32', 'E34']">
                        <br/>
                        <span id="fiscal_exp_date">
                            <strong>
                                <t t-if="o.is_ecf_invoice">Vencimiento e-NCF:</t>
                                <t t-else="">Válida hasta:</t>
                            </strong>
                            <span id="ecf_exp_date" t-field="o.l10n_do_ncf_expiration_date"/>
                        </span>
                    </t>
                </div>
            </div>
        </xpath>

        <!-- Compactar el div informations para que quede pegado al bloque anterior -->
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="class">row</attribute>
            <attribute name="t-attf-style">margin-top: 0 !important; margin-bottom: 12px !important; padding-top: 0 !important; padding-bottom: 0 !important;</attribute>
        </xpath>

        <!-- La fecha de factura ya se muestra arriba como "Fecha:" -->
        <xpath expr="//div[hasclass('page')]//div[@id='informations']/div[@name='invoice_date']" position="attributes">
            <attribute name="t-if">o.invoice_date and not is_l10n_do_invoice</attribute>
        </xpath>

        <!-- v17: la fila de información muestra "Fecha límite" y "Fuente".
             Se conservan los divs originales (due_date, origin) y solo se cambia la etiqueta. -->
        <xpath expr="//div[@id='informations']/div[@name='due_date']/strong" position="attributes">
            <attribute name="t-if">not is_l10n_do_invoice</attribute>
        </xpath>
        <xpath expr="//div[@id='informations']/div[@name='due_date']/strong" position="after">
            <strong t-if="is_l10n_do_invoice">Fecha límite:</strong>
        </xpath>

        <xpath expr="//div[@id='informations']/div[@name='origin']/strong" position="attributes">
            <attribute name="t-if">not is_l10n_do_invoice</attribute>
        </xpath>
        <xpath expr="//div[@id='informations']/div[@name='origin']/strong" position="after">
            <strong t-if="is_l10n_do_invoice">Fuente:</strong>
        </xpath>

        <xpath expr="//table[hasclass('o_main_table')]/tbody//td[hasclass('o_price_total')]" position="inside">
            <t t-if="is_l10n_do_invoice and line.price_subtotal == line.price_total">
                <span><strong>E</strong></span>
            </t>
        </xpath>

        <!-- Ocultar el QR bancario estándar cuando es factura dominicana -->
        <xpath expr="//t[@t-set='show_qr']" position="replace">
            <t t-set="show_qr" t-value="not is_l10n_do_invoice and o.display_qr_code and o.amount_residual > 0"/>
        </xpath>

        <!-- ============================================================== -->
        <!-- TRADUCCIONES AL ESPAÑOL (textos de v17)                        -->
        <!-- ============================================================== -->

        <!-- Reference -> Referencia -->
        <xpath expr="//div[@id='informations']/div[@name='reference']/strong" position="replace">
            <strong>
                <t t-if="is_l10n_do_invoice">Referencia:</t>
                <t t-else="">Reference</t>
            </strong>
        </xpath>

        <!-- Encabezados de la tabla de líneas -->
        <xpath expr="//table[@name='invoice_line_table']/thead/tr/th[@name='th_description']/span" position="replace">
            <span>
                <t t-if="is_l10n_do_invoice">Descripción</t>
                <t t-else="">Description</t>
            </span>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']/thead/tr/th[@name='th_quantity']/span" position="replace">
            <span>
                <t t-if="is_l10n_do_invoice">Cantidad</t>
                <t t-else="">Quantity</t>
            </span>
        </xpath>

        <!-- v17: "PRECIO UNITARIO" (en v19 decía "Precio Unit.") -->
        <xpath expr="//table[@name='invoice_line_table']/thead/tr/th[@name='th_priceunit']/span" position="replace">
            <span>
                <t t-if="is_l10n_do_invoice">Precio Unitario</t>
                <t t-else="">Unit Price</t>
            </span>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']/thead/tr/th[@name='th_discount']/span" position="replace">
            <span>
                <t t-if="is_l10n_do_invoice">Desc.%</t>
                <t t-else="">Disc.%</t>
            </span>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']/thead/tr/th[@name='th_taxes']/span" position="replace">
            <span>
                <t t-if="is_l10n_do_invoice">Impuestos</t>
                <t t-else="">Taxes</t>
            </span>
        </xpath>

        <!-- v17: "IMPORTE" (en v19 decía "Monto") -->
        <xpath expr="//table[@name='invoice_line_table']/thead/tr/th[@name='th_subtotal']/span" position="replace">
            <span>
                <t t-if="is_l10n_do_invoice">Importe</t>
                <t t-else="">Amount</t>
            </span>
        </xpath>

        <!-- "Paid on" / "Reversed on" -> "Pagado el" / "Reversado el" -->
        <xpath expr="//t[@t-foreach='payments_vals']//i[hasclass('oe_form_field', 'text-end', 'oe_payment_label')]" position="replace">
            <i class="oe_form_field text-end oe_payment_label">
                <t t-if="is_l10n_do_invoice">
                    <t t-if="payment_vals['is_refund']">Reversado el </t>
                    <t t-else="">Pagado el </t>
                </t>
                <t t-else="">
                    <t t-if="payment_vals['is_refund']">Reversed on </t>
                    <t t-else="">Paid on </t>
                </t>
                <t t-out="payment_vals['date']" t-options='{"widget": "date"}'/>
            </i>
        </xpath>

        <!-- v17: "Importe adeudado" (en v19 decía "Monto Pendiente") -->
        <xpath expr="//t[@t-if='len(payments_vals) > 0']/tr[hasclass('fw-bold')]/td[1]" position="replace">
            <td>
                <t t-if="is_l10n_do_invoice">Importe adeudado</t>
                <t t-else="">Amount Due</t>
            </td>
        </xpath>

        <!-- "Total amount in words" -> "Monto total en palabras" -->
        <xpath expr="//p[@t-if='o.company_id.display_invoice_amount_total_words']" position="replace">
            <p class="text-end lh-sm" t-if="o.company_id.display_invoice_amount_total_words">
                <t t-if="is_l10n_do_invoice">Monto total en palabras:</t>
                <t t-else="">Total amount in words:</t>
                <br/>
                <small class="text-muted lh-sm"><span t-field="o.amount_total_words"/></small>
            </p>
        </xpath>

        <!-- Condición para mostrar referencia de pago y cuenta bancaria -->
        <xpath expr="//div[hasclass('mb-3')][.//p[@name='payment_communication']]" position="attributes">
            <attribute name="t-if">(o.move_type in ('out_invoice', 'in_refund') and o.payment_reference) or (is_l10n_do_invoice and o.move_type == 'out_invoice' and o.partner_bank_id)</attribute>
        </xpath>
        <!-- Nota: No se modifica <p name="payment_communication"> para mantener compatibilidad -->
        <!-- con account.report_invoice_document_preview que busca t[@t-if='o.partner_bank_id'] -->

        <!-- Términos de pago y Tasa de cambio (el Origen ahora va como "Fuente" arriba) -->
        <xpath expr="//div[@id='payment_term']" position="before">
            <t t-set="display_exchange" t-value="o.currency_id and o.currency_id.name != 'DOP'"/>
            <div t-if="is_l10n_do_invoice and (o.invoice_payment_term_id or display_exchange)" class="mb-2">
                <t t-if="o.invoice_payment_term_id">
                    <strong>Términos de pago: </strong>
                    <span t-field="o.invoice_payment_term_id.name"/>
                </t>
                <t t-if="o.invoice_payment_term_id and display_exchange"> - </t>
                <t t-if="display_exchange">
                    <strong>Tasa: </strong>
                    <span t-field="o.currency_id.name"/> (<span t-field="o.currency_rate" t-options='{"widget": "float", "precision": 2}'/>)
                </t>
            </div>
        </xpath>

        <!-- Ocultar nota de términos de pago (duplicado) -->
        <xpath expr="//span[@id='payment_terms_note_id']" position="attributes">
            <attribute name="t-if">o.invoice_payment_term_id.note and not (o.l10n_latam_use_documents and o.company_id.l10n_do_country_code == 'DO')</attribute>
        </xpath>

        <!-- "Installment of" y "due on" para cuotas de pago -->
        <xpath expr="//t[@t-if='len(payment_term_details) > 1']" position="replace">
            <t t-if="len(payment_term_details) > 1" t-foreach="payment_term_details" t-as="term">
                <div>
                    <span t-out="term_index + 1"/>
                    <t t-if="is_l10n_do_invoice"> - Cuota de </t>
                    <t t-else=""> - Installment of </t>
                    <t t-options='{"widget": "monetary", "display_currency": o.currency_id}' t-out="term.get('amount')" class="text-end"/>
                    <t t-if="is_l10n_do_invoice"><span> vence el </span></t>
                    <t t-else=""><span> due on </span></t>
                    <t t-out="term.get('date')" class="text-start"/>
                </div>
            </t>
        </xpath>

    </template>

    <template id="l10n_do_report_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.user_id.lang if o.move_type in ('in_invoice', 'in_refund') else o.partner_id.lang" />
                <t t-if="o._get_name_invoice_report() == 'l10n_do_accounting.report_invoice_document_inherited'"
                   t-call="account.report_invoice_document" t-lang="lang" />
            </t>
        </t>
    </template>

    <template id="l10n_do_report_invoice_with_payments">
        <t t-call="l10n_do_accounting.l10n_do_report_invoice">
            <t t-set="print_with_payments" t-value="True"/>
        </t>
    </template>

    <!-- ================================================================== -->
    <!-- TOTALES DE IMPUESTOS (sin cambios respecto a v19)                  -->
    <!-- Traduce textos y agrega columna DOP para facturas en otra moneda   -->
    <!-- ================================================================== -->
    <template id="l10n_do_document_tax_totals" inherit_id="account.document_tax_totals">

        <!-- Rounding -> Redondeo -->
        <xpath expr="//tr[@t-if=&quot;'cash_rounding_base_amount_currency' in tax_totals&quot;]/td[1]" position="replace">
            <td>
                <t t-if="o.l10n_latam_use_documents and o.company_id.l10n_do_country_code == 'DO'">Redondeo</t>
                <t t-else="">Rounding</t>
            </td>
        </xpath>

        <xpath expr="//tr[hasclass('o_total')]/td[1]/strong" position="replace">
            <strong>
                <t t-if="o.l10n_latam_use_documents and o.company_id.l10n_do_country_code == 'DO'">Total</t>
                <t t-else="">Total</t>
            </strong>
        </xpath>

        <!-- Columna DOP en Subtotal cuando la moneda no es DOP -->
        <xpath expr="//tr[hasclass('o_subtotal')]/td[2]" position="after">
            <t t-if="o.l10n_latam_use_documents and o.company_id.l10n_do_country_code == 'DO' and o.currency_id.name != 'DOP'">
                <td class="text-end">
                    <span t-att-class="oe_subtotal_footer_separator"
                          t-out="subtotal['base_amount_currency'] * o.currency_rate"
                          t-options='{"widget": "monetary", "display_currency": o.company_currency_id}'/>
                </td>
            </t>
        </xpath>

        <!-- Columna DOP en impuestos -->
        <xpath expr="//tr[hasclass('o_taxes')]//td[hasclass('o_price_total')]" position="after">
            <t t-if="o.l10n_latam_use_documents and o.company_id.l10n_do_country_code == 'DO' and o.currency_id.name != 'DOP'">
                <td class="text-end o_price_total">
                    <span class="text-nowrap"
                          t-out="tax_group['tax_amount_currency'] * o.currency_rate"
                          t-options='{"widget": "monetary", "display_currency": o.company_currency_id}'/>
                </td>
            </t>
        </xpath>

        <!-- Columna DOP en Total -->
        <xpath expr="//tr[hasclass('o_total')]/td[2]" position="after">
            <t t-if="o.l10n_latam_use_documents and o.company_id.l10n_do_country_code == 'DO' and o.currency_id.name != 'DOP'">
                <td class="text-end">
                    <strong t-out="o.amount_total_signed"
                            t-options='{"widget": "monetary", "display_currency": o.company_currency_id}'/>
                </td>
            </t>
        </xpath>

    </template>

    <!-- Ocultar sección "Impuestos DOP" separada -->
    <template id="l10n_do_hide_company_currency_totals" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-if=&quot;o.tax_totals and o.tax_totals.get('display_in_company_currency')&quot;]" position="attributes">
            <attribute name="t-if">o.tax_totals and o.tax_totals.get('display_in_company_currency') and not (o.l10n_latam_use_documents and o.company_id.l10n_do_country_code == 'DO' and o.currency_id.name != 'DOP')</attribute>
        </xpath>
    </template>

</odoo>
