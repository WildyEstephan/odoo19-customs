<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ncf_manager_account_tax_form" model="ir.ui.view">
        <field name="name">ncf manager account tax form</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <field name="type_tax_use" position="after">
                <field name="purchase_tax_type" widget="radio"
                       invisible="type_tax_use != 'purchase'"/>
                <field name="isr_retention_type"
                       invisible="purchase_tax_type != 'isr'"
                       required="purchase_tax_type == 'isr'"/>
            </field>
            <field name="tax_scope" position="replace">
                <field name="tax_scope" invisible="type_tax_use != 'purchase'"/>
            </field>
            <field name="invoice_label" position="after">
                <field name="l10n_do_invoice_label" 
                       string="Etiqueta en Facturas (DO)" 
                       readonly="1"
                       invisible="context.get('hide_l10n_do_fields')"
                       help="Etiqueta traducida al español para impuestos de República Dominicana"/>
            </field>
        </field>
    </record>
    
    <!-- Vista de lista para impuestos con etiquetas traducidas -->
    <record id="view_account_tax_tree_l10n_do" model="ir.ui.view">
        <field name="name">account.tax.tree.l10n.do</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_label']" position="after">
                <field name="l10n_do_invoice_label" 
                       string="Etiqueta DO" 
                       optional="hide"
                       invisible="context.get('hide_l10n_do_fields')"/>
            </xpath>
        </field>
    </record>
    
    <!-- Vista de búsqueda para impuestos -->
    <record id="view_account_tax_search_l10n_do" model="ir.ui.view">
        <field name="name">account.tax.search.l10n.do</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_account_tax_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_do_invoice_label" 
                       string="Etiqueta DO"
                       invisible="context.get('hide_l10n_do_fields')"/>
            </xpath>
        </field>
    </record>
</odoo>
