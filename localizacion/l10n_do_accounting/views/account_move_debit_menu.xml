<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción para Notas de Débito de Clientes -->
    <record id="action_account_debit_note_customer" model="ir.actions.act_window">
        <field name="name">Notas de Débito a Clientes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form,activity</field>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="domain">[('move_type', '=', 'out_debit')]</field>
        <field name="context">{
            'default_move_type': 'out_debit',
            'move_type': 'out_debit',
            'search_default_posted': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nota de débito a cliente
            </p><p>
                Las notas de débito se utilizan para aumentar el importe de una factura ya emitida.
                Se crean desde una factura existente utilizando el botón "Nota de Débito".
            </p>
        </field>
    </record>

    <!-- Acción para Notas de Débito de Proveedores -->
    <record id="action_account_debit_note_vendor" model="ir.actions.act_window">
        <field name="name">Notas de Débito de Proveedores</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form,activity</field>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="domain">[('move_type', '=', 'in_debit')]</field>
        <field name="context">{
            'default_move_type': 'in_debit',
            'move_type': 'in_debit',
            'search_default_posted': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nota de débito de proveedor
            </p><p>
                Las notas de débito se utilizan para aumentar el importe de una factura de proveedor.
                Se crean desde una factura existente utilizando el botón "Nota de Débito".
            </p>
        </field>
    </record>

    <!-- Menú para Notas de Débito de Clientes -->
    <menuitem 
        id="menu_action_account_debit_note_customer"
        name="Notas de Débito"
        action="action_account_debit_note_customer"
        parent="account.menu_finance_receivables"
        sequence="5"
        groups="account.group_account_invoice"/>

    <!-- Menú para Notas de Débito de Proveedores -->
    <menuitem 
        id="menu_action_account_debit_note_vendor"
        name="Notas de Débito"
        action="action_account_debit_note_vendor"
        parent="account.menu_finance_payables"
        sequence="5"
        groups="account.group_account_invoice"/>

    <!-- Acción para todas las Notas de Débito en reportes -->
    <record id="action_account_debit_note_all" model="ir.actions.act_window">
        <field name="name">Notas de Débito</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form,activity</field>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="domain">[('move_type', 'in', ['out_debit', 'in_debit'])]</field>
        <field name="context">{
            'search_default_posted': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Ver todas las notas de débito
            </p><p>
                Aquí puedes ver todas las notas de débito tanto de clientes como de proveedores.
            </p>
        </field>
    </record>

</odoo>