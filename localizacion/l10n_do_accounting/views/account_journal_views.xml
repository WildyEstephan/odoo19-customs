<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="model">account.journal</field>
        <field name="name">account.journal.form</field>
        <field name="inherit_id" ref="l10n_latam_invoice_document.view_account_journal_form"/>
        <field name="arch" type="xml">
            <!-- Rename "Use Documents?" to "Es Fiscal" -->
            <xpath expr="//field[@name='l10n_latam_use_documents']" position="attributes">
                <attribute name="string">Es Fiscal</attribute>
            </xpath>
            <!-- Add payment form field for bank/cash journals -->
            <xpath expr="//field[@name='l10n_latam_use_documents']" position="after">
                <field name="l10n_do_payment_form"
                    invisible="type not in ('cash', 'bank') or country_code != 'DO'"
                    required="type in ('cash', 'bank')"/>
            </xpath>
        </field>
    </record>
</odoo>
