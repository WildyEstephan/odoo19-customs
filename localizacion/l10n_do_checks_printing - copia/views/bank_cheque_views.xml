<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="bank_cheque_attribute_view_form" model="ir.ui.view">
            <field name="name">bank.cheque.attribute.form.view</field>
            <field name="model">bank.cheque.attribute</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="attribute"/>
                                <field name="date_format">
                                    <attribute name="invisible">[('attribute', '!=', 'cheque_date')]</attribute>
                                    <attribute name="required">[('attribute', '=', 'cheque_date')]</attribute>
                                </field>
                            </group>
                            <group>
                                <field name="demo_data">
                                    <attribute name="invisible">[('attribute', '=', 'cheque_date')]</attribute>
                                </field>
                                <field name="demo_data_date">
                                    <attribute name="invisible">[('attribute', '!=', 'cheque_date')]</attribute>
                                </field>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="bank_cheque_attribute_view_tree" model="ir.ui.view">
            <field name="name">bank.cheque.attribute.view.list</field>
            <field name="model">bank.cheque.attribute</field>
            <field name="arch" type="xml">
                <list string="Bank Cheque Attributes">
                    <field name="name"/>
                    <field name="attribute"/>
                </list>
            </field>
        </record>

        <record id="bank_cheque_attribute_action" model="ir.actions.act_window">
            <field name="name">Bank Cheque Attributes</field>
            <field name="res_model">bank.cheque.attribute</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="bank_cheque_attribute_menu" name="Cheque Atributos" parent="l10n_do_checks_printing.l10n_do_checks_printing_menu" action="bank_cheque_attribute_action" sequence="2" />
    </data>
</odoo>
