        <!-- Impuestos ITBIS para República Dominicana -->
        
        <!-- ITBIS 18% Ventas -->
        <record id="tax_itbis_18_sale" model="account.tax">
            <field name="name">ITBIS 18% (Ventas)</field>
            <field name="description">ITBIS18S</field>
            <field name="amount">18</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="country_id" ref="base.do"/>
            <field name="tax_group_id" ref="tax_group_itbis_18"/>
            <field name="invoice_repartition_line_ids" eval="[
                (0, 0, {'factor_percent': 100, 'repartition_type': 'base'}),
                (0, 0, {'factor_percent': 100, 'repartition_type': 'tax'}),
            ]"/>
            <field name="refund_repartition_line_ids" eval="[
                (0, 0, {'factor_percent': 100, 'repartition_type': 'base'}),
                (0, 0, {'factor_percent': 100, 'repartition_type': 'tax'}),
