<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ecf_document_view_search" model="ir.ui.view">
        <field name="name">ecf.document.view.search</field>
        <field name="model">ecf.document</field>
        <field name="arch" type="xml">
            <search string="Document">
                <field name="name"/>
                <field name="partner_id"/>
                <group>
                    <filter string="State" name="filter_state" context="{'group_by': 'l10n_do_ecf_send_state'}"/>
                    <filter string="Document Type" name="filter_document_type"
                            context="{'group_by': 'l10n_latam_document_type_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="ecf_document_tree_view" model="ir.ui.view">
        <field name="name">ecf.document.list.view</field>
        <field name="model">ecf.document</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" duplicate="0">
                <field name="name"/>
                <field name="create_date"/>
                <field name="l10n_latam_document_type_id"/>
                <field name="partner_id"/>
                <field name="xml_amount_tax" sum="Amount Total Tax" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                <field name="xml_amount_total" sum="Amount Total" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                <field name="company_currency_id" optional="hidden"/>
                <field name="l10n_do_ecf_send_state" widget="badge"
                       decoration-danger="l10n_do_ecf_send_state in ('invalid', 'delivered_refused')"
                       decoration-warning="l10n_do_ecf_send_state in ('contingency', 'delivered_pending', 'delivered_pending', 'not_sent',  'service_unreachable', 'signed_pending')"
                       decoration-success="l10n_do_ecf_send_state in ('delivered_accepted', 'conditionally_accepted')"
                       decoration-info="l10n_do_ecf_send_state == 'to_send'"/>

            </list>
        </field>
    </record>
    <record id="ecf_document_form_view" model="ir.ui.view">
        <field name="name">ecf.document.form.view</field>
        <field name="model">ecf.document</field>
        <field name="arch" type="xml">
            <form string="Electronic Document" edit="0" create="0" duplicate="false" delete="0">
                <header>
                    <button name="action_gen_xml" type="object" string="Gen XML" class="oe_highlight"
                            invisible="xml_file != False or l10n_do_ecf_send_state != 'to_send'"/>

                    <button name="action_send_to_netvux" type="object" string="Sent to NETVUX"
                            class="oe_highlight" invisible="l10n_do_ecf_send_state not in ['to_send'] or not xml_file"/>

<!--                    <button name="action_recreate_xml" type="object" string="Recreate XML"-->
<!--                            invisible="l10n_do_ecf_send_state not in ['to_send'] or not xml_file"/>-->

                    <button name="action_request_state_to_netvux" type="object" string="Request State NETVUX"
                            class="oe_highlight" invisible="l10n_do_ecf_send_state not in ['delivered_pending', 'not_sent', 'signed_pending'] or not xml_file"/>

                    <field name="l10n_do_ecf_send_state" widget="statusbar" statusbar_visible="signed_pending,delivered_accepted,delivered_refused"/>
                </header>
                <div class="alert alert-danger" role="alert" invisible="not netvux_warning_message">
                    <div class="o_row">
                        <field name="netvux_warning_message" style="width:auto !important;"/>
                        <br></br>
                        <button name="action_recreate_xml" type="object" string="Retry" class="oe_link oe_inline"
                                invisible="l10n_do_ecf_send_state not in ['to_send'] or not xml_file"
                                groups="account.group_account_invoice"/>
                    </div>
                </div>
                <sheet string="Electronic Documents">
                    <div class="oe_button_box" name="button_box">
                        <img src='/l10n_do_ecf/static/img/logo_dgii.png' width="140px" heigth="60px" alt="DGII Logo"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="invoice_id" invisible="not invoice_id" groups="account.group_account_invoice"/>
                            <field name="l10n_latam_document_type_id"/>
                            <field name="partner_id"/>
                            <field name="ncf_type" invisible="1"/>
                            <field name="send_dgii" invisible="1"/>
                            <field name="is_rfce" invisible="ncf_type != 32"/>
                        </group>
                        <group>
                            <field name="xml_file" readonly="1" filename="xml_file_name"/>
                            <field name="xml_netvux_file" readonly="1" filename="xml_file_name" invisible="not xml_netvux_file"/>
                            <field name="xml_file_name" readonly="1" invisible="1"/>
                            <field name="xml_amount_tax" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                            <field name="xml_amount_total" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                            <field name="company_currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <notebook colspan="4">
                        <page string="Message DGII" name="message_dgii" invisible="l10n_do_ecf_send_state in ['to_send', 'signed_pending']">
                            <group>
                                <group id="dgii_message">
                                    <field name="message_detail_dgii" groups="base.group_no_one"/>
                                </group>
                            </group>
                        </page>
                        <page string="QR" name="QR_code">
                            <group>
                                <group>
                                    <field name="QR_code" widget="image" invisible="not QR_code"
                                           nolabel="1" options="{'size': [120, 120]}"/>
                                </group>
                                <group>
                                    <field name="l10n_do_ecf_security_code" invisible="1"/>
                                    <field name="l10n_do_ecf_sign_date" invisible="1"/>
                                    <field name="l10n_do_electronic_stamp" invisible="not l10n_do_electronic_stamp"
                                           widget="CopyClipboardText"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_ecf_document_action" model="ir.actions.act_window">
        <field name="name">Electronic Documents</field>
        <field name="res_model">ecf.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Haga clic para agregar un documento.
            </p>
            <p>
                Una documento es un registro de la compañia a la DGII que genera la facturacion electrónica.
            </p>
        </field>
    </record>
</odoo>
