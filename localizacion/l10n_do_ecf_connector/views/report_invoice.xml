<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="l10n_do_ecf_report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='qrcode']" position="after">
            <div t-if="ecf_representation and o.l10n_do_electronic_stamp">
                <div>
                    <img width="95" height="95" class="media-object" t-att-src="image_data_uri(o.QR_code)"/>
                </div>
                <table style="font-size:11px;">
                    <tr t-if="o.l10n_do_ecf_security_code">
                        <td>
                            <strong>Código de Seguridad: </strong>
                            <span t-field="o.l10n_do_ecf_security_code"/>
                        </td>
                    </tr>
                    <tr t-if="o.l10n_do_ecf_sign_date">
                        <td>
                            <strong>Fecha Firma Digital: </strong>
                            <span t-esc="o.l10n_do_ecf_sign_date.strftime('%d-%m-%Y %H:%M:%S')" t-if="o.l10n_do_ecf_sign_date"/>
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>
    </template>
</odoo>
