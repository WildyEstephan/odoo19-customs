<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="invoice_triple_discount_form_view" model="ir.ui.view">
        <field name="name">account.invoice.triple.discount.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- List view -->
            <xpath
                expr="//field[@name='invoice_line_ids']//list//field[@name='discount']"
                position="after"
            >
                <field
                    name="discount2"
                    groups="account_invoice_triple_discount.group_discount_per_so_line"
                    optional="show"
                />
                <field
                    name="discount3"
                    groups="account_invoice_triple_discount.group_discount_per_so_line"
                    optional="show"
                />
            </xpath>
            <!-- Form view embedded in the list -->
            <xpath
                expr="//field[@name='invoice_line_ids']//form//field[@name='discount']"
                position="after"
            >
                <field name="discount2" groups="account_invoice_triple_discount.group_discount_per_so_line" />
                <field name="discount3" groups="account_invoice_triple_discount.group_discount_per_so_line" />
            </xpath>
        </field>
    </record>
</odoo>
