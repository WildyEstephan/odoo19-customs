<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="hr_employee_inherit_form_view">
            <field name="name">hr.employee.form.bank_account_and_pay_form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <!-- Si bank_account_id no existe, lo agregamos -->
                <xpath expr="//field[@name='work_email']" position="after">
                    <field name="bank_account_id" placeholder="Cuenta Bancaria"/>
                    <field name="pay_form" placeholder="Forma de Pago"/>
                    <field name="payment_journal_id"
                           placeholder="Diario de Pago"
                           invisible="pay_form not in ('cheque', 'cash')"
                           required="pay_form in ('cheque', 'cash')"
                           domain="[('type', '=', 'bank')]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
