<?xml version="1.0" encoding="utf-8"?>
<!-- MODIFICADO: Arturo Diaz Lora - 2026-03-19 01:20 -->
<!-- Razón: Mejorar vista del wizard con totales de retención y mejor layout -->
<odoo>
    <data>
        <record id="withholding_certificacion_wizard_form" model="ir.ui.view">
            <field name="name">withholding_certification_wizard_form</field>
            <field name="model">withholding.certification.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group string="Parámetros de Búsqueda">
                            <field name="partner_id" required="1"
                                   options="{'no_create': True}"
                                   domain="[('supplier_rank', '>', 0)]"/>
                            <field name="date_from" required="1"/>
                            <field name="date_to" required="1"/>
                        </group>
                        <group string="Datos del Período">
                            <field name="month" readonly="1"/>
                            <field name="year" readonly="1"/>
                            <field name="now_date" readonly="1" force_save="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Resumen de Retenciones" invisible="not invoice_ids">
                        <group>
                            <field name="total_base" readonly="1"/>
                            <field name="total_itbis_retenido" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_isr_retenido" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Facturas">
                            <field name="invoice_ids"
                                   options="{'no_create': True}"
                                   domain="[('partner_id', '=', partner_id), ('move_type', 'in', ['in_invoice', 'in_refund']), ('state', '=', 'posted')]">
                                <list>
                                    <field name="invoice_date" string="Fecha"/>
                                    <field name="l10n_latam_document_number" string="NCF"/>
                                    <field name="partner_id" string="Proveedor" column_invisible="True"/>
                                    <field name="amount_untaxed" string="Base Imponible"/>
                                    <field name="invoiced_itbis" string="ITBIS Facturado"/>
                                    <field name="withholded_itbis" string="ITBIS Retenido"/>
                                    <field name="income_withholding" string="ISR Retenido"/>
                                    <field name="amount_total" string="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                        <button name="generate_certification"
                                string="Generar Certificación"
                                type="object"
                                class="btn-primary"
                                invisible="not invoice_ids"/>
                        <button string="Cancelar" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="withholding_certificacion_wizard_action" model="ir.actions.act_window">
            <field name="name">Certificación de Retención DGII</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">withholding.certification.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="withholding_certificacion_menu"
                  name="Certificación de Retención"
                  parent="dgii_reports.account_dgii_menu"
                  sequence="7"
                  action="withholding_certificacion_wizard_action"/>
    </data>
</odoo>
