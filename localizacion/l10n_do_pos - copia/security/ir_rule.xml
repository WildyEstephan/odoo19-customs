<!-- Razón: Regla multi-company para pos.search_criteria -->
<odoo>

    <record id="pos_search_criteria_comp_rule" model="ir.rule">
        <field name="name">POS Search Criteria Company Rule</field>
        <field name="model_id" ref="model_pos_search_criteria"/>
        <field eval="True" name="global"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
