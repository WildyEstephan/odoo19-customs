<?xml version="1.0" encoding="UTF-8"?>
<templates id="template">
    <t t-name="l10n_do_pos.SelectPartnerButton" t-inherit="point_of_sale.SelectPartnerButton" t-inherit-mode="extension">
        <xpath expr="//button" position="replace">
            <button class="set-partner btn btn-light btn-lg lh-lg text-truncate w-auto" t-on-click="() => this.pos.selectPartner()">
                <div class="d-flex flex-column align-items-center">
                    <span style="font-size:10px;" t-if="props.partner and props.partner.l10n_do_dgii_tax_payer_type">
                        <t t-esc="pos.payer_types_selection[props.partner.l10n_do_dgii_tax_payer_type]"/>
                    </span>
                    <div t-if="props.partner" class="text-truncate text-action">
                        <t t-esc="props.partner.name" />
                    </div>
                    <t t-else="">Customer</t>
                </div>
            </button>
        </xpath>
    </t>
</templates>
