<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- 607 -->

    <record id="invoice_form_inherited" model="ir.ui.view">
        <field name="name">invoice.form.inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[last()]" position="after">
                <page name="dgii_fields" string="DGII" groups="account.group_account_user" invisible="move_type not in ('out_refund', 'out_invoice')">
                    <group>
                        <!-- Información Fiscal -->
                        <group col="2" string="Información Fiscal" groups="account.group_account_manager">
                            <field name="fiscal_status" widget="state_selection" readonly="1" string="Estado 607"/>
                        </group>
                        
                        <!-- Impuestos Facturados -->
                        <group col="2" string="Impuestos Facturados" groups="account.group_account_manager">
                            <field name="invoiced_itbis" string="ITBIS Facturado"/>
                            <field name="selective_tax" string="Impuesto Selectivo"/>
                            <field name="other_taxes" string="Otros Impuestos"/>
                            <field name="legal_tip" string="Propina Legal"/>
                        </group>
                        
                        <!-- Retenciones por Terceros -->
                        <group col="2" string="Retenciones por Terceros" groups="account.group_account_manager">
                            <field name="third_withheld_itbis" string="ITBIS Retenido por Tercero"/>
                            <field name="third_income_withholding" string="Retención Renta por Tercero"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <record id="invoice_tree_inherited" model="ir.ui.view">
        <field name="name">invoice.list.inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="fiscal_status" widget="state_selection" readonly="1"
                       groups="account.group_account_user"/>
            </xpath>
        </field>
    </record>

    <!-- 606 -->

    <record id="invoice_supplier_form_inherited" model="ir.ui.view">
        <field name="name">invoice.supplier.form.inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="before">
                <field name="is_exterior" invisible="1"/>
                <field name="service_type" invisible="not is_exterior"
                                           required="is_exterior"/>
                <field name="service_type_detail" options="{'no_create': True, 'no_open': True}"
                       invisible="not is_exterior"
                       readonly="not service_type"
                       required="service_type != False"/>
            </xpath>
            <xpath expr="//page[last()]" position="after">
                <page name="dgii_fields" string="DGII" groups="account.group_account_user" invisible="move_type not in ('in_refund', 'in_invoice')">
                    <group>
                        <!-- Información de Facturación -->
                        <group col="2" string="Información de Facturación" groups="account.group_account_manager">
                            <field name="fiscal_status" widget="state_selection" readonly="1" string="Estado 606"/>
                        </group>
                        
                        <!-- Montos por Tipo -->
                        <group col="2" string="Montos por Tipo" groups="account.group_account_manager">
                            <field name="service_total_amount" string="Monto Total Servicios"/>
                            <field name="good_total_amount" string="Monto Total Bienes"/>
                        </group>
                        
                        <!-- Impuestos ITBIS -->
                        <group col="2" string="Impuestos ITBIS" groups="account.group_account_manager">
                            <field name="invoiced_itbis" string="ITBIS Facturado"/>
                            <field name="proportionality_tax" string="Impuesto de Proporcionalidad"/>
                            <field name="cost_itbis" string="ITBIS Costo"/>
                            <field name="advance_itbis" string="ITBIS Avanzado"/>
                        </group>
                        
                        <!-- Otros Impuestos -->
                        <group col="2" string="Otros Impuestos" groups="account.group_account_manager">
                            <field name="selective_tax" string="Impuesto Selectivo"/>
                            <field name="other_taxes" string="Otros Impuestos"/>
                            <field name="legal_tip" string="Propina Legal"/>
                        </group>
                        
                        <!-- Retenciones -->
                        <group col="2" string="Retenciones" groups="account.group_account_manager">
                            <field name="withholded_itbis" string="ITBIS Retenido"/>
                            <field name="isr_withholding_type" string="Tipo Retención ISR"/>
                            <field name="income_withholding" string="Retención Renta"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="invoice_supplier_tree_inherited" model="ir.ui.view">
        <field name="name">invoice.supplier.list.inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="fiscal_status" widget="state_selection" readonly="1"
                       groups="account.group_account_user"/>
            </xpath>
        </field>
    </record>

</odoo>
