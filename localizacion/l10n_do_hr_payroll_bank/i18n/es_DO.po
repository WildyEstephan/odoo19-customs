#. module: l10n_do_hr_payroll_bank
#. odoo-python
#: code:addons/l10n_do_hr_payroll_bank/model/electronic_payroll.py:0
msgid ""
"Configuración de Nómina Electrónica Incompleta\n"
"\n"
"El diario '%s' no tiene una cuenta bancaria asociada.\n"
"\n"
"SOLUCIÓN:\n"
"1. Vaya a: Contabilidad > Configuración > Diarios\n"
"2. Abra el diario: %s\n"
"3. En la pestaña 'Configuración Avanzada', complete el campo 'Número de Cuenta'\n"
"4. Seleccione o cree una cuenta bancaria de la empresa\n"
"5. Asegúrese de que la cuenta bancaria tenga configurado el 'Tipo de Nómina Electrónica'"
msgstr ""
"Configuracion de Nomina Electronica Incompleta\n"
"\n"
"El diario '%s' no tiene una cuenta bancaria asociada.\n"
"\n"
"SOLUCION:\n"
"1. Vaya a: Contabilidad > Configuracion > Diarios\n"
"2. Abra el diario: %s\n"
"3. En la pestana 'Configuracion Avanzada', complete el campo 'Numero de Cuenta'\n"
"4. Seleccione o cree una cuenta bancaria de la empresa\n"
"5. Asegurese de que la cuenta bancaria tenga configurado el 'Tipo de Nomina Electronica'"


#. module: l10n_do_hr_payroll_bank
#. odoo-python
#: code:addons/l10n_do_hr_payroll_bank/model/electronic_payroll.py:0
msgid ""
"Configuración de Nómina Electrónica Incompleta\n"
"\n"
"La cuenta bancaria '%s' del diario '%s' no tiene configurado el Tipo de Nómina Electrónica.\n"
"\n"
"SOLUCIÓN:\n"
"1. Vaya a: Contabilidad > Configuración > Cuentas Bancarias\n"
"2. Abra la cuenta bancaria: %s\n"
"3. Complete el campo 'Tipo de Nómina Electrónica' seleccionando su banco:\n"
"   • Banco BHD\n"
"   • Banco Popular\n"
"   • Banco Lopez de Haro\n"
"   • Banco Reservas\n"
"   • Banco Caribe\n"
"4. Guarde los cambios e intente generar el archivo nuevamente"
msgstr ""
"Configuracion de Nomina Electronica Incompleta\n"
"\n"
"La cuenta bancaria '%s' del diario '%s' no tiene configurado el Tipo de Nomina Electronica.\n"
"\n"
"SOLUCION:\n"
"1. Vaya a: Contabilidad > Configuracion > Cuentas Bancarias\n"
"2. Abra la cuenta bancaria: %s\n"
"3. Complete el campo 'Tipo de Nomina Electronica' seleccionando su banco:\n"
"   - Banco BHD\n"
"   - Banco Popular\n"
"   - Banco Lopez de Haro\n"
"   - Banco Reservas\n"
"   - Banco Caribe\n"
"4. Guarde los cambios e intente generar el archivo nuevamente"


