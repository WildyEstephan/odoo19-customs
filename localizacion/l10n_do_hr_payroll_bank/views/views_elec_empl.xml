<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- List View -->
    <record model="ir.ui.view" id="electronic_payroll_tree">
      <field name="name">electronic_payroll Tree</field>
      <field name="model">electronic.payroll</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="effective_date"/>
          <field name="company_id" groups="base.group_multi_company"/>
        </list>
      </field>
    </record>

    <!-- Form View -->
    <record model="ir.ui.view" id="electronic_payroll_form">
      <field name="name">nomina_electronica form</field>
      <field name="model">electronic.payroll</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="set_line_ids" string="Load Lines" type="object" class="oe_highlight"/>
            <button name="generate_txt" string="Generate File" type="object" class="oe_highlight"/>
          </header>
          <sheet>
            <div class="oe_title">
              <label for="name" class="oe_edit_only"/>
              <h1>
                <field name="name"/>
              </h1>
            </div>
            <group>
              <group>
                <field name="payslip_run_id" domain="[('state','=','close')]" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="journal_id" options="{'no_create': True, 'no_edit': True}"/>
                <field name="binary_name" invisible="1"/>
                <field name="binary_ext"/>
                <field name="binary" filename="binary_name" invisible="not binary"/>
              </group>
              <group>
                <field name="effective_date"/>
                <label for="total_valid" invisible="not line_ids"/>
                <div invisible="not line_ids">
                  <field name="total_valid" class="oe_inline"/> /
                  <field name="total" class="oe_inline"/>
                </div>
                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
              </group>
            </group>

            <!-- Notebook with Tabs -->
            <notebook>
              <page string="Transferencia" invisible="not line_tran_ids">
                <field name="line_tran_ids" domain="[('no_file', '=', True)]">
                  <list create="false">
                    <field name="electronic_id" column_invisible="1"/>
                    <field name="employee_id"/>
                    <field name="bank_account_id"/>
                    <field name="amount"/>
                  </list>
                </field>
              </page>

              <page string="Efectivo" invisible="not line_cash_ids">
                <field name="line_cash_ids">
                  <list>
                    <field name="electronic_id" column_invisible="1"/>
                    <field name="employee_id"/>
                    <field name="amount"/>
                  </list>
                </field>
              </page>

              <page string="Cheque" invisible="not line_cheque_ids">
                <field name="line_cheque_ids">
                  <list>
                    <field name="electronic_id" column_invisible="1"/>
                    <field name="employee_id"/>
                    <field name="amount"/>
                  </list>
                </field>
              </page>

              <page string="General">
                <field name="line_ids" readonly="1">
                  <list>
                    <field name="electronic_id" column_invisible="1"/>
                    <field name="employee_id"/>
                    <field name="bank_account_id"/>
                    <field name="amount"/>
                    <field name="pay_form"/>
                    <field name="no_file" widget="boolean_toggle" readonly="1"/>
                  </list>
                </field>
              </page>
            </notebook>

            <!-- Totals Section -->
            <group col="1">
              <group colspan="1">
                <group class="oe_subtotal_footer">
                  <field name="total_trans" invisible="total_trans == 0"/>
                  <field name="total_cheque" invisible="total_cheque == 0"/>
                  <field name="total_cash" invisible="total_cash == 0"/>
                  <field name="total" string="Total a Pagar" class="oe_subtotal_footer_separator"/>
                </group>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Action Window -->
    <record model="ir.actions.act_window" id="electronice_payroll_action_window">
      <field name="name">Nómina Electrónica</field>
      <field name="res_model">electronic.payroll</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem name="Nómina Electrónica" id="electronic_payroll_menu"
              parent="hr_payroll.menu_hr_payroll_payslips"
              action="electronice_payroll_action_window"/>
  </data>
</odoo>
