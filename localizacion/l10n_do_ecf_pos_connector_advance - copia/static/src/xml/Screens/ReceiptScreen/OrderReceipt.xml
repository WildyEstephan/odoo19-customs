<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="inside">
            <div>
                <div t-if="props.data.QR_code" style="text-align: center; padding:0px; margin:0px;">
                    <img class="pos-receipt-logo" t-att-src="'data:image/png;base64,' + props.data.QR_code"/>
                </div>
                <div t-else="" style="text-align: center; padding:0px; margin:0px;">COMPROBANTE PROVISIONAL
                </div>
                <div t-if="props.data.l10n_do_ecf_security_code" class="pos-receipt-center-align">
                    <span>Código de Seguridad:</span>
                    <span t-esc="props.data.l10n_do_ecf_security_code"/>
                </div>
                <div t-if="props.data.l10n_do_ecf_sign_date" class="pos-receipt-center-align">
                    <span>Fecha Firma Digital:</span>
                    <span t-esc="props.data.l10n_do_ecf_sign_date"/>
                </div>
            </div>
        </xpath>
    </t>
</templates>