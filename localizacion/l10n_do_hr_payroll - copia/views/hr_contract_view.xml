<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Vista heredada para agregar campos de República Dominicana en hr.employee
        En Odoo 19, hr.version (antes hr.contract) se edita dentro del formulario de empleado
    -->
    <record id="hr_employee_view_form_inherit_do" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.do</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="priority">50</field>
        <field name="arch" type="xml">

            <!-- Agregar campos de República Dominicana en la pestaña de información de nómina -->
            <xpath expr="//page[@name='payroll_information']//group[@name='payroll_group']" position="inside">
                <group string="República Dominicana - Nómina" name="do_payroll_group">
                    <field name="income_type" required="1" />
                    <field name="payrolltype_id" required="1" />
                    <field name="deduction_plan" />
                    <field name="scheduled_retentions"
                           invisible="not deduction_plan"
                           required="deduction_plan" />
                    <field name="is_foreign" />
                    <field name="allow_accumulation" />
                    <field name="retencion_unico" />
                    <field name="rnc_retencion_unico"
                           invisible="not retencion_unico"
                           required="retencion_unico" />
                    <field name="remuneracion"
                           invisible="not retencion_unico"
                           required="retencion_unico" />
                </group>
            </xpath>

            <!-- Agregar campos adicionales de salario después de wage -->
            <xpath expr="//div[@name='wage']" position="after">
                <label for="dieta_amount"/>
                <div class="o_row" name="dieta_amount">
                    <field name="dieta_amount" nolabel="1"/>
                </div>
                <label for="fixed_loan"/>
                <div class="o_row" name="fixed_loan">
                    <field name="fixed_loan" nolabel="1"/>
                </div>
                <label for="amount_saved"/>
                <div class="o_row" name="amount_saved">
                    <field name="amount_saved" nolabel="1"/>
                </div>
                <label for="comission_rate"/>
                <div class="o_row" name="comission_rate">
                    <field name="comission_rate" nolabel="1"/>
                    <span>%</span>
                </div>
            </xpath>

            <!-- Agregar schedule_form_pay después de schedule_pay -->
            <xpath expr="//field[@name='schedule_pay']" position="after">
                <field name="schedule_form_pay" readonly="1" invisible="1" />
            </xpath>

        </field>
    </record>

    <!-- Heredar vista de hr_payroll para hacer readonly los campos wage_type y schedule_pay -->
    <record id="hr_employee_view_form_inherit_payroll_readonly" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.payroll.readonly</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form" />
        <field name="priority">99</field>
        <field name="arch" type="xml">

            <!-- Hacer wage_type readonly -->
            <xpath expr="//field[@name='wage_type']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <!-- Hacer schedule_pay readonly -->
            <xpath expr="//field[@name='schedule_pay']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

        </field>
    </record>

</odoo>
