#. module: l10n_do_hr_payroll
#: model:mail.template,body_html:l10n_do_hr_payroll.mail_template_payslip
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Estimado/a ${object.employee_id.name},</p>\n"
"    \n"
"    <p>Adjunto encontrará su nómina correspondiente al período <strong>${object.name}</strong>.</p>\n"
"    \n"
"    <table style=\"border-collapse: collapse; width: 100%; margin: 20px 0;\">\n"
"        <tr>\n"
"            <td style=\"border: 1px solid #ddd; padding: 8px; background-color: #f2f2f2;\"><strong>Empleado:</strong></td>\n"
"            <td style=\"border: 1px solid #ddd; padding: 8px;\">${object.employee_id.name}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"border: 1px solid #ddd; padding: 8px; background-color: #f2f2f2;\"><strong>Período:</strong></td>\n"
"            <td style=\"border: 1px solid #ddd; padding: 8px;\">${object.date_from.strftime('%d/%m/%Y')} - ${object.date_to.strftime('%d/%m/%Y')}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"border: 1px solid #ddd; padding: 8px; background-color: #f2f2f2;\"><strong>Nómina:</strong></td>\n"
"            <td style=\"border: 1px solid #ddd; padding: 8px;\">${object.name}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"border: 1px solid #ddd; padding: 8px; background-color: #f2f2f2;\"><strong>Total a recibir:</strong></td>\n"
"            <td style=\"border: 1px solid #ddd; padding: 8px;\">${object.company_id.currency_id.symbol} ${'{:,.2f}'.format(object.total_to_pay or 0.0)}</td>\n"
"        </tr>\n"
"    </table>\n"
"    \n"
"    <p>Si tiene alguna pregunta sobre su nómina, no dude en contactarnos.</p>\n"
"    \n"
"    <p>Saludos cordiales,<br/>\n"
"    <strong>Departamento de Recursos Humanos</strong><br/>\n"
"    ${object.company_id.name}</p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Estimado/a ${object.employee_id.name},</p>\n"
"    \n"
