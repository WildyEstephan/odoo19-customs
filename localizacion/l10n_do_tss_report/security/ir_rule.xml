<!-- Razón: Estandarizar regla de tss.report y agregar regla para tss.report.line -->
<odoo>

    <record id="tss_reports_rule" model="ir.rule">
        <field name="name">TSS Reports Company Rule</field>
        <field name="model_id" ref="model_tss_report"/>
        <field eval="True" name="global"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="tss_reports_line_rule" model="ir.rule">
        <field name="name">TSS Reports Line Company Rule</field>
        <field name="model_id" ref="model_tss_report_line"/>
        <field eval="True" name="global"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
