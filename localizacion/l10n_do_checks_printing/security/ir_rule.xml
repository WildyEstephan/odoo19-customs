<!-- Razón: Agregar regla multi-company para bank.cheque.attribute -->
<odoo>
    <record id="check_report_config_comp_rule" model="ir.rule">
        <field name="name">Check Report Config Company Rule</field>
        <field name="model_id" ref="model_check_report_config"/>
        <field eval="True" name="global"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="bank_cheque_attribute_line_comp_rule" model="ir.rule">
        <field name="name">Bank Cheque Attribute Line Company Rule</field>
        <field name="model_id" ref="model_bank_cheque_attribute_line"/>
        <field eval="True" name="global"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="bank_cheque_attribute_comp_rule" model="ir.rule">
        <field name="name">Bank Cheque Attribute Company Rule</field>
        <field name="model_id" ref="model_bank_cheque_attribute"/>
        <field eval="True" name="global"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
