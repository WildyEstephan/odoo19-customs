<odoo>
    <record id="pos_config_view_form_inherit" model="ir.ui.view">
        <field name="name">pos_config_view_form_inherit</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting id="only_invoice">
                    <field name="only_invoice" readonly="has_active_session"/>
                    <div class="content-group">
                        <div class="text-muted">
                            Forza a crear facturas al confirmar el pedido,
                            considere deshabilitar esta opcion en cualquier otro caso.
                        </div>
                        <div class="content-group mt16" invisible="not only_invoice">
							<div class="row mt16">
								<label string="Default customer" for="default_partner_id" class="col-lg-3 o_light_label"/>
								<field name="default_partner_id" readonly="has_active_session == True"/>
							</div>
						</div>
                    </div>
                </setting>
                <setting id="show_receipt_logo">
                    <field name="show_receipt_logo" readonly="has_active_session"/>
                    <div class="content-group">
                        <div class="text-muted">
                            Controla si el logo de la empresa se muestra en los recibos del POS.
                            Desmarca para ocultar el logo en las impresiones y previsualizaciones.
                        </div>
                    </div>
                </setting>
                <setting id="l10n_do_disable_auto_print_invoice">
                    <field name="l10n_do_disable_auto_print_invoice" readonly="has_active_session"/>
                    <div class="content-group">
                        <div class="text-muted">
                            Desactiva la impresión automática de la factura en formato A4 desde el POS.
                            Cuando está activado, solo se imprime el recibo del POS, no el reporte completo de factura.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
