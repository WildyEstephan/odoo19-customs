<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sobrescribir la regla de multiempresa para pos.payment.method -->
        <!-- Permitir métodos de pago sin empresa (company_id = NULL) que sean visibles para todas las empresas -->
        <record id="point_of_sale.rule_pos_payment_method_multi_company" model="ir.rule">
            <field name="name">PoS Payment Method</field>
            <field name="model_id" ref="point_of_sale.model_pos_payment_method"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>