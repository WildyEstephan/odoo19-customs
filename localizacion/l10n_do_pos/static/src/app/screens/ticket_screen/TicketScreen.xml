<?xml version="1.0" encoding="UTF-8"?>
<!--
    Autor: Arturo Diaz Lora
    Fecha: 2025-11-26 03:20
    Descripción: Extensión del TicketScreen para mostrar NCF en el historial de órdenes

    Actualización 2026-01-10:
    - Corregido: Actualizado para Odoo 19 - usa estructura de tabla en lugar de divs
    - Mejorado: Verificar tanto ncf como l10n_latam_document_number
    - Agregado: Columna NCF en vista desktop y móvil
    - Corregido: Xpath usa td[@name='delete-column'] para mayor robustez
-->
<templates id="template" xml:space="preserve">
    <t t-name="TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <!-- Agregar columna NCF en las filas de órdenes (vista escritorio) -->
        <!-- Autor: Arturo Diaz Lora - 2026-01-10 - Actualizado para Odoo 19 -->
        <!-- Agregamos el NCF antes de la columna delete que tiene name="delete-column" -->
        <xpath expr="//div[hasclass('orders')]/t/table/tbody/t/tr[hasclass('order-row')]/td[@name='delete-column']" position="before">
            <td class="align-middle">
                <t t-set="orderNCF" t-value="order.l10n_latam_document_number || order.ncf"/>
                <div t-if="orderNCF and order.finalized" class="text-truncate fw-bolder" style="max-width: 150px; font-size: 0.85rem;" t-att-title="orderNCF">
                    <t t-esc="orderNCF"/>
                </div>
            </td>
        </xpath>

        <!-- Agregar NCF en vista móvil - antes del div delete-column -->
        <!-- Autor: Arturo Diaz Lora - 2026-01-10 - Corregido xpath con doble t element -->
        <xpath expr="//div[hasclass('orders')]/t/t/div[hasclass('mobileOrderList')]/div[@name='delete-column']" position="before">
            <t t-set="mobileOrderNCF" t-value="order.l10n_latam_document_number || order.ncf"/>
            <div t-if="mobileOrderNCF and order.finalized" class="p-2 d-flex flex-column justify-content-center align-items-end" style="font-size: 0.75rem;">
                <span class="text-muted fw-bolder">NCF:</span>
                <span class="text-truncate" style="max-width: 100px;"><t t-esc="mobileOrderNCF"/></span>
            </div>
        </xpath>
    </t>
</templates>
