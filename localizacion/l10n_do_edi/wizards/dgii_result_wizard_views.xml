<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dgii_result_wizard_form" model="ir.ui.view">
        <field name="name">dgii.result.wizard.form</field>
        <field name="model">dgii.result.wizard</field>
        <field name="arch" type="xml">
            <form string="Resultado del envío a DGII">
                <sheet>
                    <div class="oe_title">
                        <h1>Resultado del envío a DGII</h1>
                    </div>
                    <group>
                        <field name="move_id" invisible="1"/>
                        <field name="message" nolabel="1" widget="html" readonly="1" 
                               style="min-height: 200px;"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Descargar XML" type="object" name="action_download_xml" class="btn-primary"/>
                    <button string="Cerrar" type="object" name="action_close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>