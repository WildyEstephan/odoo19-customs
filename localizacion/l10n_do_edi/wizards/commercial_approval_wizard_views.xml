<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commercial_approval_wizard_form" model="ir.ui.view">
        <field name="name">l10n.do.commercial.approval.wizard.form</field>
        <field name="model">l10n.do.commercial.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Aprobación Comercial">
                <sheet>
                    <group>
                        <group string="Información de la Factura">
                            <field name="move_id" readonly="1"/>
                        </group>
                        <group string="Aprobación Comercial">
                            <field name="status"/>
                            <field name="detail" placeholder="Ingrese el detalle del motivo del rechazo..." 
                                   invisible="status == '1'"/>
                            <field name="show_date_field" invisible="1"/>
                            <field name="date_approval" 
                                   invisible="not show_date_field"
                                   placeholder="dd-mm-yyyy hh:mm:ss"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_accept" string="Enviar a la DGII" type="object" class="btn-primary"/>
                    <button name="action_reject" string="Cancelar" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo> 