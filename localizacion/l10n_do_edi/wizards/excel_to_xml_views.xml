<odoo>
  <record id="view_excel_to_xml_wizard_form" model="ir.ui.view">
    <field name="name">wizard.excel.to.xml.form</field>
    <field name="model">ecf.excel.to.xml</field>
    <field name="arch" type="xml">
      <form string="Importar Excel ECF">
        <group>
          <field name="file" filename="file_name" widget="binary"/>
          <field name="file_name" invisible="1"/>
        </group>
        <footer>
          <button string="Generar XMLs" type="object" name="action_generate_xml" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>

        <notebook>
          <page string="Casos Generados">
            <field name="cases_ids" nolabel="1" create="false" options="{'no_create': True, 'no_open': True}">
              <list string="Casos">
                <field name="name"/>
                <field name="xml_filename" invisible="1"/>
                <field name="xml_file" filename="xml_filename" widget="binary"/>
                <field name="file_version" invisible="1"/>
                <field name="is_authorized"/>
                <field name="dgii_result"/>
                <field name="use_modified_xml"/>
                <field name="modified_xml_file" filename="modified_xml_filename" widget="binary" invisible="not use_modified_xml"/>
                <field name="modified_xml_filename" invisible="1"/>
                <button string="Enviar" type="object" name="action_send_xml" class="btn-primary" invisible="is_authorized"/>
              </list>
            </field>
          </page>
        </notebook>
      </form>
    </field>
  </record>

  <record id="action_excel_to_xml_wizard" model="ir.actions.act_window">
    <field name="name">Importar ECF Excel</field>
    <field name="res_model">ecf.excel.to.xml</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <!-- Menú temporalmente comentado hasta encontrar el padre correcto en l10n_do
  <menuitem id="menu_ecf_import" name="Importar Excel" parent="account.menu_finance"
            action="action_excel_to_xml_wizard" sequence="1"/>
  -->
</odoo>
