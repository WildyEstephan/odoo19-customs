<odoo>
    <record id="edi_format_do_ecf" model="account.edi.format">
        <field name="name">DGII e-CF (República Dominicana)</field>
        <field name="code">dgii_ecf</field>
    </record>
    <record id="edi_format_do_rfce" model="account.edi.format">
        <field name="name">DGII RFCE (República Dominicana)</field>
        <field name="code">dgii_rfce</field>
    </record>
    
    <!-- Configurar automáticamente el formato EDI en journals de ventas para RD -->
    <record id="setup_edi_formats" model="ir.actions.server">
        <field name="name">Configurar formatos EDI para RD</field>
        <field name="model_id" ref="account.model_account_journal"/>
        <field name="state">code</field>
        <field name="code">
model._setup_l10n_do_edi_formats()
        </field>
    </record>
</odoo>
