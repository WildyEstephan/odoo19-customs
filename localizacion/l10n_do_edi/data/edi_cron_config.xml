<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Autor: Arturo Diaz Lora
        Fecha: 2025-12-02 21:50
        Razón: Cambiar intervalo del cron EDI de 1 día a 15 minutos para que las facturas
               se envíen a DGII más rápidamente. El valor por defecto de Odoo (1 día) causa
               que las facturas queden pendientes mucho tiempo, especialmente las del POS
               que deberían enviarse casi inmediatamente.
    -->
    <record id="account_edi.ir_cron_edi_network" model="ir.cron">
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
