<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="view_hr_payslip_form_inherited_v2" model="ir.ui.view">
        <field name="name">view.hr.payslip.form.inherited.v2</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <!-- Modificado: 2026-03-18 — Arturo Diaz Lora — Ocultar campos Días trabajados parciales y Vacaciones -->
            <xpath expr="//field[@name='struct_id']" position="after">
                <field name="partial_worked_days" invisible="1"/>
                <field name="last_payslip_vacation" invisible="1"/>
                <field name="pay_vacation" invisible="1"/>
                <field name="vacation_type" invisible="1"/>
            </xpath>

            <!-- MODIFICADO: Arturo Diaz Lora - 2026-04-03 -->
            <!-- Razón: Ocultar botón "Crear reporte de pago" - no funcional en nómina individual -->
            <xpath expr="//button[@name='action_payslip_payment_report']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- MODIFICADO: Arturo Diaz Lora - 2026-04-04 -->
            <!-- Razón: Agregar botón "Reporte de Pago" al lado de "Confirmar" para generar reporte del lote -->
            <xpath expr="//button[@name='action_payslip_done']" position="after">
                <button string="Reporte de Pago"
                        name="action_run_payment_report"
                        type="object"
                        class="btn btn-secondary"
                        invisible="state != 'validated' or not payslip_run_id"
                        help="Generar reporte de pago del lote de nómina asociado"/>
            </xpath>
        </field>
    </record>

    <record id="hr_payslip_tree_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.list.inherit</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list//field[@name='date_from']" position="before">
                <field name="real_worked_hours" string="Horas trabajadas"/>
                <field name="total_to_pay" string="Total a Pagar"/>
            </xpath>

            <!-- MODIFICADO: Arturo Diaz Lora - 2026-04-04 -->
            <!-- Razón: Agregar botón "Reporte de Pago" en la vista lista al lado de Confirmar -->
            <xpath expr="//header/button[@name='action_payslip_done']" position="after">
                <button string="Reporte de Pago"
                        name="action_run_payment_report"
                        type="object"/>
            </xpath>
        </field>
    </record>

