    <!-- Agregar botón para enviar nómina por correo -->
    <record id="view_hr_payslip_form_inherit_email_button" model="ir.ui.view">
        <field name="name">view.hr.payslip.form.inherit.email.button</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_payslip_done']" position="before">
                <button
                    string="Enviar por correo"
                    name="payslip_send_mail"
                    type="object"
                    class="oe_highlight"
                />
            </xpath>
        </field>
    </record>

    <!-- Configuración de templates de correo -->
    <!-- MODIFICADO: Arturo Diaz Lora - 2026-03-27 19:30 -->
    <!-- Razón: Agregar bloque de configuración de correo para nóminas con servidor específico -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.payroll.do</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50" />
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <!-- Insertar después del bloque principal de Payroll -->
            <xpath expr="//block[@id='hr_payroll_settings']" position="after">
                <block title="Configuración de Correo RD" id="hr_payroll_mail_settings_do">
                    <setting string="Plantilla de Correo" help="Plantilla para envío de recibos de nómina">
                        <div class="content-group">
                            <div class="row">
                                <label for="choose_mail_template" class="col-lg-3 o_light_label"/>
                                <field name="choose_mail_template" domain="[('model_id.model','=', 'hr.payslip')]"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Servidor de Correo para Nóminas" help="Servidor SMTP específico para envío de nóminas. Si no se selecciona, se usa el de mayor prioridad.">
                        <div class="content-group">
                            <div class="row">
                                <label for="hr_payroll_mail_server_id" class="col-lg-3 o_light_label"/>
                                <field name="hr_payroll_mail_server_id" options="{'no_create': True, 'no_open': True}"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <!-- Acción de servidor para enviar nóminas por correo -->
    <record id="action_send_payslip_by_email" model="ir.actions.server">
        <field name="name">Enviar nomina por correo</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip" />
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip" />
        <field name="code">
            action = records.send_payslip_by_email_action()
        </field>
    </record>



</odoo>
