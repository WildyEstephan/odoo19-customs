<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista para agregar campo Principal en hr.payroll.structure.type -->
    <record id="hr_payroll_structure_type_form_inherit" model="ir.ui.view">
        <field name="name">hr.payroll.structure.type.form.inherit</field>
        <field name="model">hr.payroll.structure.type</field>
        <field name="inherit_id" ref="hr_payroll.hr_payroll_structure_type_view_form"/>
        <field name="arch" type="xml">
            <!-- Agregar campo Principal después del nombre con formato nativo Odoo -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_main_type"/>
            </xpath>
        </field>
    </record>

    <!-- Vista lista para mostrar el campo Principal -->
    <record id="hr_payroll_structure_type_tree_inherit" model="ir.ui.view">
        <field name="name">hr.payroll.structure.type.tree.inherit</field>
        <field name="model">hr.payroll.structure.type</field>
        <field name="inherit_id" ref="hr_payroll.hr_payroll_structure_type_view_tree"/>
        <field name="arch" type="xml">
            <!-- Agregar campo Principal en la lista -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_main_type" string="Principal"/>
            </xpath>
        </field>
    </record>
</odoo>