<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template de correo para nóminas individuales -->
    <record id="mail_template_payslip" model="mail.template">
        <field name="name">Envío de Nómina</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="subject">Nómina - ${object.employee_id.name} - ${object.name}</field>
        <field name="email_from">${object.company_id.email or user.email}</field>
        <field name="email_to">${object.employee_id.work_email}</field>
        <field name="body_html"><![CDATA[
<div style="margin: 0px; padding: 0px;">
    <p>Estimado/a ${object.employee_id.name},</p>
    
    <p>Adjunto encontrará su nómina correspondiente al período <strong>${object.name}</strong>.</p>
    
    <table style="border-collapse: collapse; width: 100%; margin: 20px 0;">
        <tr>
            <td style="border: 1px solid #ddd; padding: 8px; background-color: #f2f2f2;"><strong>Empleado:</strong></td>
            <td style="border: 1px solid #ddd; padding: 8px;">${object.employee_id.name}</td>
        </tr>
        <tr>
            <td style="border: 1px solid #ddd; padding: 8px; background-color: #f2f2f2;"><strong>Período:</strong></td>
            <td style="border: 1px solid #ddd; padding: 8px;">${object.date_from.strftime('%d/%m/%Y')} - ${object.date_to.strftime('%d/%m/%Y')}</td>
        </tr>
        <tr>
            <td style="border: 1px solid #ddd; padding: 8px; background-color: #f2f2f2;"><strong>Nómina:</strong></td>
            <td style="border: 1px solid #ddd; padding: 8px;">${object.name}</td>
        </tr>
        <tr>
            <td style="border: 1px solid #ddd; padding: 8px; background-color: #f2f2f2;"><strong>Total a recibir:</strong></td>
            <td style="border: 1px solid #ddd; padding: 8px;">${object.company_id.currency_id.symbol} ${'{:,.2f}'.format(object.total_to_pay or 0.0)}</td>
        </tr>
    </table>
    
    <p>Si tiene alguna pregunta sobre su nómina, no dude en contactarnos.</p>
    
    <p>Saludos cordiales,<br/>
    <strong>Departamento de Recursos Humanos</strong><br/>
    ${object.company_id.name}</p>
</div>
        ]]></field>
        <field name="auto_delete" eval="True"/>
    </record>



    <!-- Configurar template por defecto -->
    <!-- MODIFICADO: Arturo Diaz Lora - 2026-04-22 04:25 -->
    <!-- Razón: Envuelto en noupdate=1 (patrón estándar Odoo) y corregido a eval (evita re-ejecución en updates) -->
    <!-- Código original: <function> con <value> hijos sin noupdate -->
    <data noupdate="1">
        <function model="ir.config_parameter" name="set_param" eval="('l10n_do_hr_payroll.choose_mail_template', ref('mail_template_payslip'))"/>
    </data>



</odoo>